local tripHighlights = {}
local tripBillboards = {}
local tripColorESP   = Color3.fromRGB(255, 50, 50)
local tripDetectConn = nil
local tripNoCDConn   = nil

local function cleanTripESP()
    for _, h in pairs(tripHighlights) do pcall(function() h:Destroy() end) end
    for _, b in pairs(tripBillboards) do pcall(function() b:Destroy() end) end
    tripHighlights = {}
    tripBillboards = {}
