-- =============================================
--   CONFIG SYSTEM
-- =============================================

local CONFIG_FOLDER  = "banware"
local SETTINGS_FOLDER = CONFIG_FOLDER .. "/Settings"
local AUTOLOAD_FILE  = SETTINGS_FOLDER .. "/autoload.txt"

local function ensureFolders()
    if not isfolder(CONFIG_FOLDER) then
        makefolder(CONFIG_FOLDER)
    end
    if not isfolder(SETTINGS_FOLDER) then
        makefolder(SETTINGS_FOLDER)
    end
end

ensureFolders()

local SavedConfig    = {}
local autoSaveEnabled = false
local autoSaveThread  = nil
local currentCfgName  = "default"

local function getConfigPath(name)
    return SETTINGS_FOLDER .. "/" .. (name or currentCfgName) .. ".json"
end

local function saveConfig(name)
    ensureFolders()
    local path = getConfigPath(name)
    local ok, str = pcall(function()
        return HttpService:JSONEncode(SavedConfig)
    end)
    if ok then
        writefile(path, str)
        return true
    end
    return false
end

local function loadConfig(name)
    ensureFolders()
    local path = getConfigPath(name)
    if not isfile(path) then return false end
    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(path))
    end)
    if ok and type(data) == "table" then
        SavedConfig = data
        return true
    end
    return false
end

local function deleteConfig(name)
    local path = getConfigPath(name)
    if isfile(path) then
        delfile(path)
        return true
    end
    return false
end

local function setAutoload(name)
    ensureFolders()
    writefile(AUTOLOAD_FILE, name)
end

local function getAutoload()
    if not isfile(AUTOLOAD_FILE) then return nil end
    local ok, name = pcall(readfile, AUTOLOAD_FILE)
    return ok and name or nil
end

local function listConfigs()
    ensureFolders()
    local list = {}
    local ok, files = pcall(listfiles, SETTINGS_FOLDER)
    if ok then
        for _, f in ipairs(files) do
            local name = f:match("([^/\\]+)%.json$")
            if name then
                table.insert(list, name)
            end
        end
    end
    return list
end

local function setConfig(key, val)
    SavedConfig[key] = val
end

local function getConfig(key, default)
    local v = SavedConfig[key]
    if v == nil then return default end
    return v
end

local function startAutoSave()
    autoSaveEnabled = true
    autoSaveThread = task.spawn(function()
        while autoSaveEnabled do
            task.wait(30)
            if autoSaveEnabled then
                saveConfig(currentCfgName)
            end
        end
    end)
end

local function stopAutoSave()
    autoSaveEnabled = false
    if autoSaveThread then
        task.cancel(autoSaveThread)
        autoSaveThread = nil
    end
end

-- Auto load on start
local autoloadName = getAutoload()
if autoloadName then
    loadConfig(autoloadName)
    currentCfgName = autoloadName
end

