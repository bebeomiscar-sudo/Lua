-- =============================================
--   CONFIG SYSTEM
-- =============================================

local CONFIG_FOLDER = "RivalsHub"
local CONFIG_FILE   = CONFIG_FOLDER .. "/config.json"

local function ensureFolder()
    if not isfolder(CONFIG_FOLDER) then
        makefolder(CONFIG_FOLDER)
    end
end

local SavedConfig = {}

local function saveConfig()
    ensureFolder()
    local ok, str = pcall(function()
        return HttpService:JSONEncode(SavedConfig)
    end)
    if ok then
        writefile(CONFIG_FILE, str)
    end
end

local function loadConfig()
    ensureFolder()
    if not isfile(CONFIG_FILE) then return end
    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(CONFIG_FILE))
    end)
    if ok and type(data) == "table" then
        SavedConfig = data
    end
end

local function setConfig(key, val)
    SavedConfig[key] = val
end

local function getConfig(key, default)
    local v = SavedConfig[key]
    if v == nil then return default end
    return v
end

-- Auto save every 30 seconds
local autoSaveEnabled = false
local autoSaveThread  = nil

local function startAutoSave()
    autoSaveEnabled = true
    autoSaveThread  = task.spawn(function()
        while autoSaveEnabled do
            task.wait(30)
            if autoSaveEnabled then
                saveConfig()
            end
        end
    end)
end

local function stopAutoSave()
    autoSaveEnabled = false
    if autoSaveThread then
        task.cancel(autoSaveThread)
        autoSaveThread = nil
    end
end

-- Load on start
loadConfig()

