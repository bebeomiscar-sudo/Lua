local hbScanT = 0

track(RunService.Heartbeat:Connect(function(dt)
    local char = lp.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")

    -- VOID SPAM
    if Features.betterVoid and hrp then
        pcall(function()
            voidHRP  = hrp
            clientC  = hrp.CFrame
            clientV  = hrp.AssemblyLinearVelocity
            clientVA = hrp.AssemblyAngularVelocity
            local vPos = getBetterVoidPos()
            hrp.CFrame = CFrame.new(vPos)
                * CFrame.Angles(math.pi, math.pi, math.pi)
            hrp.AssemblyLinearVelocity  = getBetterVoidVel()
            hrp.AssemblyAngularVelocity = getBetterVoidVel()
        end)
    end

    -- VELOCITY SPIKE
    if Features.velSpike and hrp then
        if tick() - lastSpike >= velSpikeRate then
            lastSpike = tick()
            pcall(function()
                hrp.AssemblyLinearVelocity = getBetterVoidVel()
            end)
        end
    end

    -- ANTI AIM STANDARD
    if Features.antiAim
        and Features.antiAimMode == "Standard"
        and UpdateCamRemote and util then
        pcall(function()
            local encoded = util:EncodeCameraRotation(antiAimLocked)
            UpdateCamRemote:FireServer(encoded, nil)
        end)
    end

    -- SLINGSHOT
    if Features.slingshot then
        hbScanT += dt
        if hbScanT >= SLING_SCAN_RATE then
            hbScanT = 0
            pcall(function()
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= lp and p.Character then
                        local h = p.Character
                            :FindFirstChild("HumanoidRootPart")
                        if h then
                            pcall(function()
                                sethiddenproperty(h, "CFrame", SLING_VOID)
                            end)
                            h.CFrame = SLING_VOID
                            h.AssemblyLinearVelocity  = Vector3.zero
                            h.AssemblyAngularVelocity = Vector3.zero
                        end
                    end
                end
                for obj in pairs(trackedProj) do
                    if obj and obj.Parent then
                        improvedSlingshotObj(obj)
                    else
                        trackedProj[obj] = nil
                    end
                end
                for _, o in ipairs(workspace:GetChildren()) do
                    if matchesMode(o.Name) and o:IsA("BasePart") then
                        improvedSlingshotObj(o)
                    end
                end
            end)
        end
    end

    -- RIOT
    if Features.riot and riotRunning and hrp then
        pcall(function()
            local t   = tick() - riotCfg.t0
            local yaw = math.rad(riotCfg.spinSpeed * dt)
            local pitch = math.rad(
                riotCfg.spinSpeed * 0.37 * dt * math.sin(t * 3.1)
            )
            local roll  = math.rad(
                riotCfg.spinSpeed * 0.19 * dt
                * math.cos(t * 5.7 + riotCfg.seed)
            )
            local spinCF = hrp.CFrame * CFrame.Angles(pitch, yaw, roll)
            local spread = riotCfg.distance / 300
            local jX = (math.random()-0.5)*riotCfg.xJitter*spread*2
                + math.noise(t*9, riotCfg.seed, 0)*riotCfg.xJitter*spread
            local jY = (math.random()-0.5)*riotCfg.yJitter*spread
                + math.noise(0, t*9, riotCfg.seed)*riotCfg.yJitter*spread*0.3
            local jZ = (math.random()-0.5)*riotCfg.xJitter*spread*2
                + math.noise(0, 0, t*9+riotCfg.seed)*riotCfg.xJitter*spread
            local newY = math.max(spinCF.Position.Y + jY, 2)
            hrp.CFrame = spinCF + Vector3.new(jX, newY-spinCF.Position.Y, jZ)
        end)
    end
end))

