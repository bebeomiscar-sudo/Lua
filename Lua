-- =============================================
--   BETTER VOID SPAM
--   Uses full int32 range with betterRandom
-- =============================================

local voidHRP    = nil
local clientC    = nil
local clientV    = nil
local clientVA   = nil

local voidHBConn    = nil
local velSpikeConn  = nil
local antiAimConn   = nil
local antiAimLocked = nil

local function betterRandom(mi, ma, dmi, dma)
    if dmi <= mi and dma >= ma then
        return math.random(mi, ma)
    end
    local val
    local attempts = 0
    repeat
        val = math.random(mi, ma)
        attempts += 1
    until (val < dmi or val > dma) or attempts >= 50
    return val
end

local INT_MIN = -2147483646
local INT_MAX =  2147483646
local INT_DEAD_MIN = -1147483646
local INT_DEAD_MAX =  1147483646

local function getBetterVoidPos()
    return Vector3.new(
        betterRandom(INT_MIN, INT_MAX, INT_DEAD_MIN, INT_DEAD_MAX),
        betterRandom(INT_MIN, INT_MAX, INT_DEAD_MIN, INT_DEAD_MAX),
        betterRandom(INT_MIN, INT_MAX, INT_DEAD_MIN, INT_DEAD_MAX)
    )
end

local function getBetterVoidVel()
    return Vector3.new(
        betterRandom(INT_MIN, INT_MAX, INT_DEAD_MIN, INT_DEAD_MAX),
        betterRandom(INT_MIN, INT_MAX, INT_DEAD_MIN, INT_DEAD_MAX),
        betterRandom(INT_MIN, INT_MAX, INT_DEAD_MIN, INT_DEAD_MAX)
    )
end

local function startBetterVoid()
    if voidHBConn then
        voidHBConn:Disconnect()
        voidHBConn = nil
    end
    pcall(function()
        RunService:UnbindFromRenderStep("VoidSync")
    end)

    voidHBConn = RunService.Heartbeat:Connect(function()
        pcall(function()
            local char = lp.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            voidHRP  = hrp
            clientC  = hrp.CFrame
            clientV  = hrp.AssemblyLinearVelocity
            clientVA = hrp.AssemblyAngularVelocity

            hrp.CFrame = CFrame.new(getBetterVoidPos())
                * CFrame.Angles(
                    math.rad(math.pi),
                    math.rad(math.pi),
                    math.rad(math.pi)
                )
            hrp.AssemblyLinearVelocity  = getBetterVoidVel()
            hrp.AssemblyAngularVelocity = getBetterVoidVel()
        end)
    end)

    RunService:BindToRenderStep(
        "VoidSync",
        Enum.RenderPriority.First.Value,
        function()
            if voidHRP and clientC then
                pcall(function()
                    voidHRP.CFrame = clientC
                    voidHRP.AssemblyLinearVelocity  = clientV
                    voidHRP.AssemblyAngularVelocity = clientVA
                end)
            end
        end
    )
end

local function stopBetterVoid()
    if voidHBConn then
        voidHBConn:Disconnect()
        voidHBConn = nil
    end
    pcall(function()
        RunService:UnbindFromRenderStep("VoidSync")
    end)
    voidHRP  = nil
    clientC  = nil
    clientV  = nil
    clientVA = nil
end

