            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 then continue end
            local head = char:FindFirstChild("Head")
            if not head then continue end
            local d = (workspace.CurrentCamera.CFrame.Position
                - head.Position).Magnitude
            if d < bd then bd = d; best = p end
        end
        return best
    end

    function wbState:getHitPart(char)
        return WB.hitPart == "Head"
            and char:FindFirstChild("Head")
            or  char:FindFirstChild("UpperTorso")
            or  char:FindFirstChild("Torso")
            or  char:FindFirstChild("HumanoidRootPart")
    end

    -- =============================================
    --   WALLBANG TELEPORT DESYNC WITH 3 OFFSETS
    --   Teleports through 3 positions rapidly
    --   then restores — confuses server hit reg
    -- =============================================

    function wbState:teleportDesync(targetChar)
        local root = lp.Character
            and lp.Character:FindFirstChild("HumanoidRootPart")
        if not root then return end

        local head = targetChar:FindFirstChild("Head")
        if not head then return end

        local savedCF = root.CFrame
        local savedLV = root.AssemblyLinearVelocity
        local savedAV = root.AssemblyAngularVelocity

        -- Pass through 3 offsets rapidly
        -- Each offset relative to target head
        local offsets = {
            wbDesyncCfg.offset1,
            wbDesyncCfg.offset2,
            wbDesyncCfg.offset3,
        }

        task.spawn(function()
            for _, offset in ipairs(offsets) do
                pcall(function()
                    root.CFrame = CFrame.new(
                        head.Position + offset
                    )
                end)
                -- sethiddenproperty to bypass network ownership check
                pcall(function()
                    sethiddenproperty(
                        root, "CFrame",
                        CFrame.new(head.Position + offset)
                    )
                end)
                task.wait(0.016) -- ~1 frame
            end

            -- Restore via RenderStep
            RunService:BindToRenderStep(
                "__wbDesyncRestore",
                Enum.RenderPriority.First.Value,
                function()
                    pcall(function()
                        root.CFrame              = savedCF
                        root.AssemblyLinearVelocity  = savedLV
                        root.AssemblyAngularVelocity = savedAV
                    end)
                    RunService:UnbindFromRenderStep(
                        "__wbDesyncRestore"
                    )
                end
            )
        end)
    end

    function wbState:desyncStart(tp2)
        if self.conn2 then self.conn2:Disconnect() end
        self.desync = true

        local head = tp2.Character
            and tp2.Character:FindFirstChild("Head")
        if not head then return end

        self.conn2 = RunService.Heartbeat:Connect(function()
            if not self.desync then return end
            local root = lp.Character
                and lp.Character:FindFirstChild("HumanoidRootPart")
            if not root then return end
            local tc2 = tp2.Character
            if not tc2 then self:desyncStop(); return end
            local h2  = tc2:FindFirstChild("Head")
            if not h2 then self:desyncStop(); return end

            local sCF = root.CFrame
            local sLV = root.AssemblyLinearVelocity
            local sAV = root.AssemblyAngularVelocity

            root.CFrame = h2.CFrame * CFrame.new(0, -5, 0)

            -- sethiddenproperty for stronger desync
            pcall(function()
                sethiddenproperty(
                    root, "CFrame",
                    h2.CFrame * CFrame.new(0, -5, 0)
                )
            end)

            RunService:BindToRenderStep("__wbR", 101, function()
                pcall(function()
                    root.CFrame              = sCF
                    root.AssemblyLinearVelocity  = sLV
                    root.AssemblyAngularVelocity = sAV
                end)
                RunService:UnbindFromRenderStep("__wbR")
            end)
        end)
    end

    function wbState:desyncStop()
        self.desync = false
        if self.conn2 then
            self.conn2:Disconnect()
            self.conn2 = nil
        end
        pcall(function()
            RunService:UnbindFromRenderStep("__wbR")
        end)
    end

    function wbState:setup()
        if self.conn1 then self.conn1:Disconnect() end
        self.conn1 = RunService.Heartbeat:Connect(function()
            if not self.active then return end
            self.target = self:find()
        end)

        if not __gm then return end
        if self.hooked then
            warn("[Wallbang] Already hooked")
            return
        end

        local origSS = __gm.StartShooting
        if not origSS then
            warn("[Wallbang] StartShooting not found")
            return
        end

        self.oldfunc = origSS
        local hookOk = pcall(function()
            rawset(__gm, "StartShooting", function(gSelf, ...)
                local results = { origSS(gSelf, ...) }
                if not gSelf.ClientFighter
                    or not gSelf.ClientFighter.IsLocalPlayer then
                    return table.unpack(results)
                end
                local sd = results[3]
                if not sd or typeof(sd) ~= "table" then
                    return table.unpack(results)
                end
                results[4] = true
                local tgP = self.target
                if not self.active or not tgP or not tgP.Character then
                    return table.unpack(results)
                end

                -- Run teleport desync with 3 offsets
                self:teleportDesync(tgP.Character)

                -- Standard desync
                self:desyncStart(tgP)
                task.wait(0.1)
                if self.task1 then
                    task.cancel(self.task1)
                    self.task1 = nil
                end

                local ap = self:getHitPart(tgP.Character)
                if not ap then return table.unpack(results) end

                local tPos = ap.Position
                local tCF2 = ap.CFrame
                local oPos = tPos - Vector3.new(0, 3, 0)

                if __um then
                    pcall(function()
                        sd[utf8.char(0)] = __um:EncodeCFrame(
                            CFrame.new(oPos, tPos)
                        )
                        sd[utf8.char(1)] = __um:EncodeCFrame(
                            CFrame.new(tPos)
                        )
                        sd[utf8.char(2)] = ap
                        sd[utf8.char(3)] = __um:EncodeCFrame(
                            tCF2:ToObjectSpace(CFrame.new(
                                tPos + Vector3.new(
                                    math.random(-1, 1) * 0.5,
                                    math.random(-1, 1) * 0.5,
                                    math.random(-1, 1) * 0.5
                                )
                            ))
                        )
                        if sd.Hitbox then
                            sd.Hitbox = WB.hitPart == "Head"
                                and "Head" or "Body"
                        end
                    end)
                end

                self.task1 = task.delay(0.15, function()
                    self:desyncStop()
                end)
                return table.unpack(results)
            end)
        end)

        if hookOk then
            self.hooked = true
        else
            warn("[Wallbang] Hook failed")
            self.oldfunc = nil
        end
    end

    function wbState:Start()
        self.active = true
        self:setup()
        notify("Wallbang", "Active!")
    end

    function wbState:Shutdown()
        self.active = false
        if self.conn1 then self.conn1:Disconnect(); self.conn1 = nil end
        if self.conn2 then self.conn2:Disconnect(); self.conn2 = nil end
        if self.task1 then task.cancel(self.task1); self.task1 = nil end
        pcall(function()
            RunService:UnbindFromRenderStep("__wbR")
            RunService:UnbindFromRenderStep("__wbDesyncRestore")
        end)
        if self.hooked and self.oldfunc and __gm then
            pcall(function()
                rawset(__gm, "StartShooting", self.oldfunc)
            end)
            self.oldfunc = nil
            self.hooked  = false
        end
        notify("Wallbang", "Off")
    end
end

wbState:init()

-- =============================================
--   HIDE / ATTACK SYSTEM
--   Hide: stay in void for X seconds
--   Attack: TP to enemy + wallbang shoot
--   Loop: Hide → Attack → Hide → ...
-- =============================================

local hideAttackCfg = {
    enabled       = false,
    hideTime      = 0.25,
    attackTime    = 0.1,
    shootAttempts = 1,
}

local hideAttackConn   = nil
local hideAttackThread = nil

local function getClosestEnemy()
    local best, bd = nil, math.huge
    local myChar = lp.Character
    if not myChar then return nil end
    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return nil end

    for _, p in pairs(Players:GetPlayers()) do
        if p == lp then continue end
        local char = p.Character
        if not char or not char:IsDescendantOf(workspace) then
            continue
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end
        local d = (myHRP.Position - hrp.Position).Magnitude
        if d < bd then
            bd   = d
            best = p
        end
    end
    return best
end

local function fireWallbangShot(target)
    if not target or not target.Character then return end
    local lf   = getLocalFighter()
    if not lf then return end
    local item = lf.EquippedItem
    if not item then return end

    local ap = wbState:getHitPart(target.Character)
    if not ap then return end

    -- Teleport desync before shot
    wbState:teleportDesync(target.Character)
    task.wait(0.05)

    local tPos = ap.Position
    local tCF2 = ap.CFrame
    local oPos = tPos - Vector3.new(0, 3, 0)

    if util then
        pcall(function()
            local UseItemRemote = ReplicatedStorage
                :WaitForChild("Remotes")
                :WaitForChild("Replication")
                :WaitForChild("Fighter")
                :WaitForChild("UseItem")

            local EnumLibrary = safeRequire(
                ReplicatedStorage
                    :WaitForChild("Modules")
                    :WaitForChild("EnumLibrary")
            )

            local cd = {}
            cd[utf8.char(1)] = {
                [utf8.char(0)] = util:EncodeCFrame(
                    CFrame.new(oPos, tPos)
                ),
                [utf8.char(1)] = util:EncodeCFrame(
                    CFrame.new(tPos)
                ),
                [utf8.char(2)] = ap,
                [utf8.char(3)] = util:EncodeCFrame(
                    tCF2:ToObjectSpace(CFrame.new(tPos))
                ),
            }

            UseItemRemote:FireServer(
                item:Get("ObjectID"),
                EnumLibrary:ToEnum("StartShooting"),
                cd,
                nil
            )
        end)
    end
end

local function runHideAttackLoop()
    while hideAttackCfg.enabled do
        -- HIDE PHASE: stay in void
        local char = lp.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                -- Save position
                local savedCF = hrp.CFrame
                -- Go to void
                hrp.CFrame = CFrame.new(getBetterVoidPos())
                pcall(function()
                    sethiddenproperty(
                        hrp, "CFrame",
                        CFrame.new(getBetterVoidPos())
                    )
                end)
                task.wait(hideAttackCfg.hideTime)

                if not hideAttackCfg.enabled then break end

                -- ATTACK PHASE: TP to enemy + shoot
                local enemy = getClosestEnemy()
                if enemy and enemy.Character then
                    local eHRP = enemy.Character
                        :FindFirstChild("HumanoidRootPart")
                    if eHRP then
                        -- TP on top of enemy
                        hrp.CFrame = CFrame.new(
                            eHRP.Position + Vector3.new(0, 5, 0)
                        )
                        pcall(function()
                            sethiddenproperty(
                                hrp, "CFrame",
                                CFrame.new(
                                    eHRP.Position
                                    + Vector3.new(0, 5, 0)
                                )
                            )
                        end)

                        -- Fire shoot attempts
                        for i = 1, hideAttackCfg.shootAttempts do
                            fireWallbangShot(enemy)
                            if i < hideAttackCfg.shootAttempts then
                                task.wait(0.016)
                            end
                        end
                    end
                end

                task.wait(hideAttackCfg.attackTime)
            end
        else
            task.wait(0.1)
        end
    end
end

local function startHideAttack()
    hideAttackCfg.enabled = true
    if hideAttackThread then
        task.cancel(hideAttackThread)
        hideAttackThread = nil
    end
    hideAttackThread = task.spawn(runHideAttackLoop)
end

local function stopHideAttack()
    hideAttackCfg.enabled = false
    if hideAttackThread then
        task.cancel(hideAttackThread)
        hideAttackThread = nil
    end
end

-- =============================================
--   RIOT ABUSER
-- =============================================

local riotRunning    = false
local riotConnection = nil
local riotOriginalCF = nil
local SAFE_FLOOR     = 2

local riotCfg = {
    spinSpeed = 720,
    distance  = 300,
    xJitter   = 30,
    yJitter   = 8,
}

local function startRiot()
    if riotConnection then
        riotConnection:Disconnect()
        riotConnection = nil
    end
    local char = lp.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then riotOriginalCF = hrp.CFrame end

    local t0   = tick()
    local seed = math.random(1000, 9999)
    riotRunning = true

    riotConnection = RunService.Heartbeat:Connect(function(dt)
        local targetChar = lp.Character
        local targetHRP  = targetChar
            and targetChar:FindFirstChild("HumanoidRootPart")
        if not riotRunning or not targetHRP then return end
        local t = tick() - t0

        local yaw   = math.rad(riotCfg.spinSpeed * dt)
        local pitch = math.rad(
            riotCfg.spinSpeed * 0.37 * dt * math.sin(t * 3.1)
        )
        local roll  = math.rad(
            riotCfg.spinSpeed * 0.19 * dt * math.cos(t * 5.7 + seed)
        )
        local spinCF = targetHRP.CFrame
            * CFrame.Angles(pitch, yaw, roll)

        local spread = riotCfg.distance / 300
        local jX = (math.random() - 0.5)
                    * riotCfg.xJitter * spread * 2
                    + math.noise(t * 9, seed, 0)
                    * riotCfg.xJitter * spread
        local jY = (math.random() - 0.5)
                    * riotCfg.yJitter * spread
                    + math.noise(0, t * 9, seed)
                    * riotCfg.yJitter * spread * 0.3
        local jZ = (math.random() - 0.5)
                    * riotCfg.xJitter * spread * 2
                    + math.noise(0, 0, t * 9 + seed)
                    * riotCfg.xJitter * spread

        local newY = math.max(spinCF.Position.Y + jY, SAFE_FLOOR)
        targetHRP.CFrame = spinCF
            + Vector3.new(jX, newY - spinCF.Position.Y, jZ)
    end)
end

local function stopRiot()
    riotRunning = false
    if riotConnection then
        riotConnection:Disconnect()
        riotConnection = nil
    end
    local char = lp.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if hrp and riotOriginalCF then
        hrp.CFrame = riotOriginalCF
    end
    riotOriginalCF = nil
end

-- =============================================
--   EVASION MODE
-- =============================================

local evasionConn   = nil
local evasionActive = false
local lastRepos     = 0
local lastFwdPhase  = 0
local lastUpPhase   = 0
local hsFlip        = false
local mlFlip        = false

local evasionCfg = {
    mode             = "Off",
    useCharOrigin    = false,
    baseRadius       = 500,
    randomRange      = 1.0,
    depthForward     = 0,
    depthForwardFreq = 10,
    depthUp          = 0,
    depthUpFreq      = 30,
    reposInterval    = 0.5,
    fallbackRadius   = 500,
    fallbackRandom   = 1.0,
    offset           = 0,
    hsDown           = 1.0,
    hsUp             = 1.0,
    mlDown           = 1.0,
    mlUp             = 1.0,
}

local function findNearestProjectile(hrp)
    local best, bd = nil, math.huge
    for _, obj in pairs(workspace:GetChildren()) do
        if obj:IsA("BasePart") then
            local n = obj.Name:lower()
            if n:find("projectile") or n:find("bullet") or n:find("core") then
                local d = (obj.Position - hrp.Position).Magnitude
                if d < bd then bd = d; best = obj end
            end
        end
    end
    return best
end

local function evasionRandom(hrp)
    local r     = evasionCfg.baseRadius * evasionCfg.randomRange
    local angle = math.random() * math.pi * 2
    local dist  = math.random() * r
    hrp.CFrame  = CFrame.new(
        hrp.Position.X + math.cos(angle) * dist,
        hrp.Position.Y + (math.random() - 0.5) * r * 0.3,
        hrp.Position.Z + math.sin(angle) * dist
    )
end

local function evasionProjectileMimic(hrp, dt)
    local now = tick()
    if now - lastRepos < evasionCfg.reposInterval then return end
    lastRepos = now
    local proj = findNearestProjectile(hrp)
    if proj then
        lastFwdPhase += dt * evasionCfg.depthForwardFreq
        lastUpPhase  += dt * evasionCfg.depthUpFreq
        local fwd = math.sin(lastFwdPhase) * evasionCfg.depthForward
        local up  = math.sin(lastUpPhase)  * evasionCfg.depthUp
        local projCF  = proj.CFrame
        hrp.CFrame = CFrame.new(
            proj.Position
            + projCF.LookVector * fwd
            + projCF.UpVector   * up
        )
    else
        local r     = evasionCfg.fallbackRadius * evasionCfg.fallbackRandom
        local angle = math.random() * math.pi * 2
        hrp.CFrame  = CFrame.new(
            hrp.Position.X + math.cos(angle) * r,
            hrp.Position.Y + (math.random() - 0.5) * r * 0.2,
            hrp.Position.Z + math.sin(angle) * r
        )
    end
end

local function evasionTranslocate(hrp)
    hrp.CFrame = hrp.CFrame + hrp.CFrame.LookVector * evasionCfg.offset
end

local function evasionHitscan(hrp)
    hsFlip = not hsFlip
    hrp.CFrame = hrp.CFrame
        + Vector3.new(0, hsFlip and -evasionCfg.hsDown or evasionCfg.hsUp, 0)
end

local function evasionMelee(hrp)
    mlFlip = not mlFlip
    hrp.CFrame = hrp.CFrame
        + Vector3.new(0, mlFlip and -evasionCfg.mlDown or evasionCfg.mlUp, 0)
end

local function startEvasionMode()
    if evasionConn then evasionConn:Disconnect(); evasionConn = nil end
    if evasionCfg.mode == "Off" then return end
    evasionActive = true
    evasionConn = RunService.Heartbeat:Connect(function(dt)
        if not evasionActive then return end
        local char = lp.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local mode = evasionCfg.mode
        if mode == "Random" then
            evasionRandom(hrp)
        elseif mode == "ProjectileMimic" then
            evasionProjectileMimic(hrp, dt)
        elseif mode == "Translocate" then
            evasionTranslocate(hrp)
        elseif mode == "Hitscan Strategy" then
            evasionHitscan(hrp)
        elseif mode == "Melee Strategy" then
            evasionMelee(hrp)
        end
    end)
end

local function stopEvasionMode()
    evasionActive = false
    if evasionConn then evasionConn:Disconnect(); evasionConn = nil end
end

