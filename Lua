local function predictPos(part, origin)
    if not Config.prediction.enabled or not part then
        return part and part.Position or Vector3.zero
    end
    local ping = 0
    pcall(function()
        ping = game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue() / 1000
    end)
    local dist   = (part.Position - origin).Magnitude
    local travel = dist / 3000
    local total  = (travel + ping) * Config.prediction.multiplier
    return part.Position + Config.prediction.velocity * total
end

local function updateVelocity()
    if not Config.target.character then
        Config.prediction.velocity = Vector3.zero
        return
    end
    local hrp = Config.target.character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local now = tick()
    local dt  = now - Config.prediction.lastTime
    if dt > 0 and dt < 0.1 and Config.prediction.lastPos then
        local instVel = (hrp.Position - Config.prediction.lastPos) / dt
        Config.prediction.velocity = Config.prediction.velocity:Lerp(instVel, 0.6)
    end
    Config.prediction.lastPos  = hrp.Position
    Config.prediction.lastTime = now
end

local function getHitPart(char, partName)
    if not char then return nil end
    if partName == "Head" then
        return char:FindFirstChild("HitboxHead") or char:FindFirstChild("Head")
    elseif partName == "Torso" then
        return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    elseif partName == "Closest" then
        local myHRP = getHRP()
        if not myHRP then return char:FindFirstChild("Head") end
        local closest, closestD = nil, math.huge
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then
                local d = (p.Position - myHRP.Position).Magnitude
                if d < closestD then closest = p closestD = d end
            end
        end
        return closest or char:FindFirstChild("Head")
    elseif partName == "Random" then
        local pool = {
            char:FindFirstChild("HitboxHead") or char:FindFirstChild("Head"),
            char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso"),
            char:FindFirstChild("HumanoidRootPart"),
        }
        local valid = {}
        for _, p in ipairs(pool) do if p then table.insert(valid, p) end end
        return valid[math.random(#valid)]
    else
        return char:FindFirstChild(partName) or char:FindFirstChild("Head")
    end
end

local lastFireTime = 0

local function fireSlingshot()
    -- Only fire during "shoot" phase
    if Config.void.phase == "hide" then return end

    local item = getEquipped()
    if not item then
        -- Try to equip slingshot
        local slingItem = findItemByName("Slingshot")
        if not slingItem then return end
        item = slingItem
    end

    if not isSlingEquipped() then
        equipItemBySlot(1)
        task.wait(0.05)
        item = getEquipped()
        if not item then return end
    end

    local oid = getItemOID(item)
    if not oid then return end

    local myHRP = getHRP()
    if not myHRP then return end

    local char = Config.target.character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end

    local hitPart = getHitPart(char, Config.void.hitpart)
    if not hitPart then return end

    local shootFrom = myHRP.Position

    -- If voided, we still use the VFR snapped position as origin
    if vfrSnap.cf then
        shootFrom = vfrSnap.cf.Position
    end

    local targetPos = predictPos(hitPart, shootFrom)

    -- Build UseItem data
    local data = {
        [utf8.char(1)] = {
            [utf8.char(0)] = Modules.Utility:EncodeCFrame(CFrame.new(shootFrom, targetPos)),
            [utf8.char(1)] = Modules.Utility:EncodeCFrame(CFrame.new(shootFrom, targetPos)),
            [utf8.char(2)] = hitPart,
            [utf8.char(3)] = Modules.Utility:EncodeCFrame(CFrame.new(0.43, 0.25, 0.42)),
        }
    }

    local attempts = math.clamp(math.floor(Config.void.attempts), 1, 3)
    for _ = 1, attempts do
        pcall(function()
            UseItemRemote:FireServer(
                oid,
                Modules.Enums:ToEnum("StartShooting"),
                data,
                nil
            )
        end)
    end

    lastFireTime = tick()
end

