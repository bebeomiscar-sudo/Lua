local function buildShootData(shootFrom, targetPos, hitPart)
    return {
        [utf8.char(1)] = {
            [utf8.char(0)] = Modules.Utility:EncodeCFrame(CFrame.new(shootFrom, targetPos)),
            [utf8.char(1)] = Modules.Utility:EncodeCFrame(CFrame.new(shootFrom, targetPos)),
            [utf8.char(2)] = hitPart,
            [utf8.char(3)] = Modules.Utility:EncodeCFrame(CFrame.new(0.43, 0.25, 0.42)),
        }
    }
end

local function getShootOrigin()
    if vfrSnap.cf then return vfrSnap.cf.Position end
    local hrp = getHRP()
    return hrp and hrp.Position or Vector3.zero
end

