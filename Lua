-- =============================================
--   ANTI AIM — PIXELATED
--   Scales character parts randomly
--   + sethiddenproperty to bypass sync
-- =============================================

local pixelatedConn  = nil
local pixelOrigSizes = {}

local function startPixelatedAntiAim()
    if pixelatedConn then
        pixelatedConn:Disconnect()
        pixelatedConn = nil
    end

    pixelatedConn = RunService.Heartbeat:Connect(function()
        pcall(function()
            local char = lp.Character
            if not char then return end

            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    -- Store original size once
                    if not pixelOrigSizes[part] then
                        pixelOrigSizes[part] = part.Size
                    end

                    -- Random chunk size — big and blocky
                    local chunkSize = Vector3.new(
                        math.random(3, 12),
                        math.random(3, 12),
                        math.random(3, 12)
                    )

                    -- Random rotation — confuses hitbox
                    local randCF = part.CFrame
                        * CFrame.Angles(
                            math.random() * math.pi * 2,
                            math.random() * math.pi * 2,
                            math.random() * math.pi * 2
                        )

                    -- Apply via sethiddenproperty
                    pcall(function()
                        sethiddenproperty(part, "Size",   chunkSize)
                        sethiddenproperty(part, "CFrame", randCF)
                    end)

                    -- Also direct set
                    part.Size = chunkSize
                end
            end

            -- HRP gets extra randomization
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local voidPos = getBetterVoidPos()
                pcall(function()
                    sethiddenproperty(
                        hrp, "CFrame",
                        CFrame.new(voidPos)
                        * CFrame.Angles(
                            math.random() * math.pi * 2,
                            math.random() * math.pi * 2,
                            math.random() * math.pi * 2
                        )
                    )
                end)
            end
        end)
    end)
end

local function stopPixelatedAntiAim()
    if pixelatedConn then
        pixelatedConn:Disconnect()
        pixelatedConn = nil
    end
    -- Restore original sizes
    pcall(function()
        local char = lp.Character
        if not char then return end
        for part, origSize in pairs(pixelOrigSizes) do
            pcall(function()
                if part and part.Parent then
                    part.Size = origSize
                end
            end)
        end
    end)
    pixelOrigSizes = {}
end

-- =============================================
--   PSEUDO DESYNC
--   Better than wallbang desync
--   Combines:
--   - Void position flipping
--   - CFrame angle randomization  
--   - sethiddenproperty every frame
-- =============================================

local pseudoDesyncConn = nil
local pseudoFlip       = false
local pseudoOrigCF     = nil
local pseudoAngles     = {
    CFrame.Angles(math.pi,    0,         0   ),
    CFrame.Angles(0,          math.pi,   0   ),
    CFrame.Angles(0,          0,         math.pi),
    CFrame.Angles(math.pi,    math.pi,   0   ),
    CFrame.Angles(math.pi,    0,         math.pi),
    CFrame.Angles(0,          math.pi,   math.pi),
    CFrame.Angles(math.pi,    math.pi,   math.pi),
    CFrame.Angles(math.pi*2,  math.pi,   math.pi),
}

local function startPseudoDesync()
    if pseudoDesyncConn then
        pseudoDesyncConn:Disconnect()
        pseudoDesyncConn = nil
    end

    pseudoDesyncConn = RunService.Heartbeat:Connect(function()
        pcall(function()
            local char = lp.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            -- Save real position first frame
            if not pseudoOrigCF then
                pseudoOrigCF = hrp.CFrame
            end

            pseudoFlip = not pseudoFlip

            -- Pick random angle set
            local angleSet = pseudoAngles[
                math.random(1, #pseudoAngles)
            ]

            -- Void position with angle
            local vPos  = getBetterVoidPos()
            local fakeCF = CFrame.new(vPos) * angleSet

            -- Apply fake CFrame via sethiddenproperty
            -- This is what makes it better than standard desync
            -- Server sees completely wrong position + rotation
            pcall(function()
                sethiddenproperty(hrp, "CFrame", fakeCF)
                sethiddenproperty(
                    hrp,
                    "AssemblyLinearVelocity",
                    getBetterVoidVel()
                )
                sethiddenproperty(
                    hrp,
                    "AssemblyAngularVelocity",
                    getBetterVoidVel()
                )
            end)

            -- Flip: alternate between void and real pos
            -- This is the key — server gets confused
            -- between void and real every frame
            if pseudoFlip then
                hrp.CFrame = fakeCF
                hrp.AssemblyLinearVelocity  = getBetterVoidVel()
                hrp.AssemblyAngularVelocity = getBetterVoidVel()
            else
                -- Restore real CFrame on render step
                RunService:BindToRenderStep(
                    "__pseudoRestore",
                    Enum.RenderPriority.First.Value,
                    function()
                        pcall(function()
                            if hrp and hrp.Parent then
                                hrp.CFrame = pseudoOrigCF
                                    or hrp.CFrame
                            end
                        end)
                        RunService:UnbindFromRenderStep(
                            "__pseudoRestore"
                        )
                    end
                )
            end

            -- Update real pos
            pseudoOrigCF = hrp.CFrame
        end)
    end)
end

local function stopPseudoDesync()
    if pseudoDesyncConn then
        pseudoDesyncConn:Disconnect()
        pseudoDesyncConn = nil
    end
    pcall(function()
        RunService:UnbindFromRenderStep("__pseudoRestore")
    end)
    pseudoOrigCF = nil
end

