local function getLF()
    return Modules.Fighter and Modules.Fighter.LocalFighter
end

local function getEquipped()
    local lf = getLF()
    return lf and lf.EquippedItem or nil
end

local function getItemOID(item)
    if not item then return nil end
    local oid = nil
    pcall(function() oid = item:Get("ObjectID") end)
    return oid
end

local function getItemName(item)
    if not item then return "" end
    local nm = ""
    pcall(function() nm = tostring(item:Get("Name") or "") end)
    return nm
end

local function getItemType(item)
    if not item then return "" end
    local t = ""
    pcall(function() t = tostring(item:Get("ItemType") or item:Get("Type") or "") end)
    return t
end

local function getItems()
    local lf = getLF()
    return lf and lf.Items or nil
end

local function getAllItemsList()
    local items  = getItems()
    local result = {}
    if not items then return result end
    for _, item in pairs(items) do
        if item then
            table.insert(result, item)
        end
    end
    return result
end

local function findItemByKeyword(keyword)
    keyword = keyword:lower()
    for _, item in ipairs(getAllItemsList()) do
        local nm = getItemName(item):lower()
        if nm:find(keyword, 1, true) then return item end
    end
    return nil
end

local function findItemBySlot(slotIdx)
    local items = getItems()
    if not items then return nil end
    if items[slotIdx] then return items[slotIdx] end
    for key, item in pairs(items) do
        if item then
            local s = tonumber(key)
            if s == slotIdx then return item end
            local s2 = nil
            pcall(function() s2 = tonumber(item:Get("Slot") or item:Get("Index")) end)
            if s2 == slotIdx then return item end
        end
    end
    return nil
end

