-- =============================================
--   VOID SEED + METHOD SYSTEM
-- =============================================

local voidSeed   = getConfig("VoidSeed", 12345)
local voidMethod = getConfig("VoidMethod", "Standard Int32")

-- Seed-based RNG
local function seededRandom(seed, index)
    local s = seed * 1664525 + 1013904223 + index * 214013
    s = s % 4294967296
    return (s / 4294967296) * 2 - 1
end

local voidIndex = 0

local function getBetterVoidPos()
    voidIndex += 1
    local seed = voidSeed

    if voidMethod == "Standard Int32" then
        local INT_MIN  = -2147483646
        local INT_MAX  =  2147483646
        local INT_DMIN = -1147483646
        local INT_DMAX =  1147483646
        local function bRand(mi, ma, dmi, dma)
            local val
            local attempts = 0
            repeat
                val      = math.random(mi, ma)
                attempts += 1
            until (val < dmi or val > dma) or attempts >= 50
            return val
        end
        return Vector3.new(
            bRand(INT_MIN, INT_MAX, INT_DMIN, INT_DMAX),
            bRand(INT_MIN, INT_MAX, INT_DMIN, INT_DMAX),
            bRand(INT_MIN, INT_MAX, INT_DMIN, INT_DMAX)
        )

    elseif voidMethod == "Signed Overflow" then
        local MAX = 670000000000000
        local sx = seededRandom(seed, voidIndex)     * MAX
        local sy = seededRandom(seed, voidIndex + 1) * MAX
        local sz = seededRandom(seed, voidIndex + 2) * MAX
        return Vector3.new(sx, sy, sz)

    elseif voidMethod == "Coordinate Wrap" then
        local WRAP = 670000000000000
        local t    = tick() * seed * 0.001
        return Vector3.new(
            math.sin(t * 7.3 + seed) * WRAP,
            math.cos(t * 5.1 + seed) * WRAP,
            math.sin(t * 11.7 + seed) * WRAP
        )

    elseif voidMethod == "NaN Injection" then
        -- Injects extreme values that confuse server physics
        local EXTREME = 670000000000000
        local signs   = { 1, -1 }
        local sx = signs[math.random(1, 2)]
        local sy = signs[math.random(1, 2)]
        local sz = signs[math.random(1, 2)]
        return Vector3.new(
            sx * (EXTREME * seededRandom(seed + voidIndex, 1)),
            sy * (EXTREME * seededRandom(seed + voidIndex, 2)),
            sz * (EXTREME * seededRandom(seed + voidIndex, 3))
        )

    elseif voidMethod == "Mixed Range" then
        -- Alternates between near and far void zones
        local flip  = voidIndex % 2 == 0
        local NEAR  = 1000000
        local FAR   = 670000000000000
        local range = flip and FAR or NEAR
        return Vector3.new(
            seededRandom(seed, voidIndex)     * range,
            seededRandom(seed, voidIndex + 1) * range,
            seededRandom(seed, voidIndex + 2) * range
        )
    end

    -- Fallback
    return Vector3.new(
        math.random(-2147483646, 2147483646),
        math.random(-2147483646, 2147483646),
        math.random(-2147483646, 2147483646)
    )
end

local function getBetterVoidVel()
    local MAX = 2147483646
    return Vector3.new(
        math.random(-MAX, MAX),
        math.random(-MAX, MAX),
        math.random(-MAX, MAX)
    )
end

