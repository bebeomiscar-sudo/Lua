local function isTripmine(obj)
    if not obj then return false end
    local name = obj.Name:lower()
    return name:find("tripmine") or name:find("subspace") or name:find("mine")
end

local function addTripESP(obj)
    if not obj:IsA("Model") and not obj:IsA("BasePart") then return end
    if not isTripmine(obj) then return end
    local highlight = Instance.new("SelectionBox")
    highlight.Color3              = tripColorESP
    highlight.LineThickness       = 0.05
    highlight.SurfaceTransparency = 0.6
    highlight.SurfaceColor3       = tripColorESP
    highlight.Adornee             = obj
    highlight.Parent              = workspace
    table.insert(tripHighlights, highlight)
    local part = obj:IsA("BasePart") and obj
        or obj:FindFirstChildWhichIsA("BasePart")
    if part then
        local bb = Instance.new("BillboardGui")
        bb.AlwaysOnTop = true
        bb.Size        = UDim2.new(0, 120, 0, 40)
        bb.StudsOffset = Vector3.new(0, 3, 0)
        bb.Adornee     = part
        bb.Parent      = part
        local lbl = Instance.new("TextLabel")
        lbl.Size                   = UDim2.new(1, 0, 1, 0)
        lbl.BackgroundTransparency = 1
        lbl.TextColor3             = tripColorESP
        lbl.TextStrokeTransparency = 0
        lbl.TextScaled             = true
        lbl.Font                   = Enum.Font.GothamBold
        lbl.Text                   = "TRIPMINE"
        lbl.Parent                 = bb
        local dc
        dc = RunService.Heartbeat:Connect(function()
            if not part or not part.Parent then
                dc:Disconnect()
                pcall(function() bb:Destroy() end)
                return
            end
            local myChar = lp.Character
            if myChar then
                local myHRP = myChar:FindFirstChild("HumanoidRootPart")
                if myHRP then
                    local dist = math.floor(
                        (myHRP.Position - part.Position).Magnitude
                    )
                    lbl.Text = "TRIPMINE\n" .. dist .. " studs"
                end
            end
        end)
        table.insert(tripBillboards, bb)
    end
    obj.AncestryChanged:Connect(function()
        if not obj:IsDescendantOf(workspace) then
            pcall(function() highlight:Destroy() end)
        end
    end)
end

local function scanTripmines()
    for _, obj in pairs(workspace:GetDescendants()) do
        pcall(function() addTripESP(obj) end)
    end
end

