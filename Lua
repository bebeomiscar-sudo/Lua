local function betterRandom(mi, ma, dmi, dma)
    if dmi <= mi and dma >= ma then
        return math.random(mi, ma)
    end
    local val
    local attempts = 0
    repeat
        val      = math.random(mi, ma)
        attempts += 1
    until (val < dmi or val > dma) or attempts >= 50
    return val
end

local INT_MIN  = -2147483646
local INT_MAX  =  2147483646
local INT_DMIN = -1147483646
local INT_DMAX =  1147483646

local function getBetterVoidPos()
    return Vector3.new(
        betterRandom(INT_MIN, INT_MAX, INT_DMIN, INT_DMAX),
        betterRandom(INT_MIN, INT_MAX, INT_DMIN, INT_DMAX),
        betterRandom(INT_MIN, INT_MAX, INT_DMIN, INT_DMAX)
    )
end

local function getBetterVoidVel()
    return Vector3.new(
        betterRandom(INT_MIN, INT_MAX, INT_DMIN, INT_DMAX),
        betterRandom(INT_MIN, INT_MAX, INT_DMIN, INT_DMAX),
        betterRandom(INT_MIN, INT_MAX, INT_DMIN, INT_DMAX)
    )
end

-- =============================================
--   BOW / DAGGER BYPASS
--   Uses sethiddenproperty to bypass
--   network ownership and velocity checks
-- =============================================

local bowBypassActive    = false
local daggerBypassActive = false

local function applyBowBypass(bow)
    if not bow then return end
    pcall(function()
        -- Force charge state via hidden property
        sethiddenproperty(bow, "_is_charging",     true)
        sethiddenproperty(bow, "_shoot_cooldown",  0)
        sethiddenproperty(bow, "_reload_cooldown", 0)
        -- Also rawset as fallback
        if rawget(bow, "_is_charging") ~= nil then
            bow._is_charging = true
        end
        if rawget(bow, "_shoot_cooldown") ~= nil then
            bow._shoot_cooldown = 0
        end
        if rawget(bow, "_reload_cooldown") ~= nil then
            bow._reload_cooldown = 0
        end
    end)

    -- Apply to physical bow part if exists
    pcall(function()
        local char = lp.Character
        if not char then return end
        for _, obj in pairs(char:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Name:lower():find("bow") then
                sethiddenproperty(obj, "Transparency", 0)
                sethiddenproperty(obj, "CanCollide",   false)
            end
        end
    end)
end

local function applyDaggerBypass(daggers)
    if not daggers then return end
    pcall(function()
        -- Force reload + shoot via hidden property
        sethiddenproperty(daggers, "_reload_cooldown", 0)
        sethiddenproperty(daggers, "_shoot_cooldown",  0)
        sethiddenproperty(daggers, "_reload_delay",    0)
        sethiddenproperty(daggers, "_burst_count",     0)
        sethiddenproperty(daggers, "_last_shot",       0)
        -- Rawset fallback
        if rawget(daggers, "_reload_cooldown") ~= nil then
            daggers._reload_cooldown = 0
        end
        if rawget(daggers, "_shoot_cooldown") ~= nil then
            daggers._shoot_cooldown = 0
        end
        if rawget(daggers, "_reload_delay") ~= nil then
            daggers._reload_delay = 0
        end
    end)

    -- Bypass dagger projectiles in workspace
    pcall(function()
        for _, obj in pairs(workspace:GetChildren()) do
            if obj:IsA("BasePart")
                and obj.Name:lower():find("dagger") then
                sethiddenproperty(obj, "CanCollide", false)
                sethiddenproperty(obj, "CanTouch",   false)
            end
        end
    end)
end

-- =============================================
--   UNIFIED HEARTBEAT
-- =============================================

local hbTimer    = 0
local SLING_SCAN = 0.05 -- scan interval for slingshot enemies

track(RunService.Heartbeat:Connect(function(dt)
    local char = lp.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")

    -- ============================
    --   WEAPONS (cached items)
    -- ============================

    if Features.noShootCD
        or Features.instantReload
        or Features.infiniteAmmo
        or Features.rapidBurst
        or Features.bowBypass
        or Features.daggerBypass then

        pcall(function()
            local items = getAllItems()
            for _, item in ipairs(items) do
                if Features.noShootCD then
                    if rawget(item, "_shoot_cooldown") ~= nil then
                        item._shoot_cooldown = 0
                    end
                    if rawget(item, "_use_cooldown") ~= nil then
                        item._use_cooldown = 0
                    end
                    if rawget(item, "_shoot_cooldown_no_ammo") ~= nil then
                        item._shoot_cooldown_no_ammo = 0
                    end
                end
                if Features.instantReload then
                    if rawget(item, "_reload_cooldown") ~= nil then
                        item._reload_cooldown = 0
                    end
                    if rawget(item, "_reload_cancel_cooldown") ~= nil then
                        item._reload_cancel_cooldown = 0
                    end
                    if rawget(item, "_reload_cancel_expiration") ~= nil then
                        item._reload_cancel_expiration = 0
                    end
                end
                if Features.rapidBurst then
                    if rawget(item, "_burst_count") ~= nil then
                        item._burst_count = 0
                    end
                    if rawget(item, "_last_shot") ~= nil then
                        item._last_shot = 0
                    end
                end
                if Features.infiniteAmmo then
                    local fighter = getLocalFighter()
                    if fighter then
                        fighter:SetAttribute("InfiniteAmmoReserve", true)
                        pcall(function()
                            if item:Get("Ammo") ~= nil
                                and item:Get("Ammo") <= 1 then
                                item:SimulateInputFromGameplayMechanic(
                                    "StartReloading", true
                                )
                            end
                        end)
                    end
                end
                if Features.bowBypass then
                    if item.Name == "Bow" then
                        applyBowBypass(item)
                    end
                end
                if Features.daggerBypass then
                    if item.Name == "Daggers" then
                        applyDaggerBypass(item)
                    end
                end
            end
        end)
    end

    -- ============================
    --   VOID SPAM
    -- ============================

    if Features.betterVoid and hrp then
        pcall(function()
            voidHRP  = hrp
            clientC  = hrp.CFrame
            clientV  = hrp.AssemblyLinearVelocity
            clientVA = hrp.AssemblyAngularVelocity

            local vPos = getBetterVoidPos()
            hrp.CFrame = CFrame.new(vPos)
                * CFrame.Angles(
                    math.rad(math.pi),
                    math.rad(math.pi),
                    math.rad(math.pi)
                )
            hrp.AssemblyLinearVelocity  = getBetterVoidVel()
            hrp.AssemblyAngularVelocity = getBetterVoidVel()
        end)
    end

    -- ============================
    --   VELOCITY SPIKE
    -- ============================

    if Features.velSpike and hrp then
        if tick() - lastSpike >= velSpikeRate then
            lastSpike = tick()
            pcall(function()
                hrp.AssemblyLinearVelocity = getBetterVoidVel()
            end)
        end
    end

    -- ============================
    --   ANTI AIM
    -- ============================

    if Features.antiAim and UpdateCamRemote and util then
        pcall(function()
            local encoded = util:EncodeCameraRotation(antiAimLocked)
            UpdateCamRemote:FireServer(encoded, nil)
        end)
    end

    -- ============================
    --   SLINGSHOT BYPASS
    -- ============================

    if Features.slingshot then
        hbTimer += dt
        if hbTimer >= SLING_SCAN then
            hbTimer = 0
            pcall(function()
                -- Move enemy HRPs
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= lp and p.Character then
                        local h = p.Character
                            :FindFirstChild("HumanoidRootPart")
                        if h then
                            pcall(function()
                                sethiddenproperty(h, "CFrame", SLING_VOID)
                            end)
                            h.CFrame = SLING_VOID
                            h.AssemblyLinearVelocity  = Vector3.zero
                            h.AssemblyAngularVelocity = Vector3.zero
                        end
                    end
                end
                -- Move tracked projectiles
                for obj in pairs(trackedProj) do
                    if obj and obj.Parent then
                        pcall(function()
                            sethiddenproperty(obj, "CFrame", SLING_VOID)
                        end)
                        obj.CFrame = SLING_VOID
                        obj.AssemblyLinearVelocity = Vector3.zero
                    else
                        trackedProj[obj] = nil
                    end
                end
                -- Move CoreProjectiles directly
                for _, o in ipairs(workspace:GetChildren()) do
                    if o.Name == "CoreProjectile" and o:IsA("BasePart") then
                        pcall(function()
                            sethiddenproperty(o, "CFrame", SLING_VOID)
                        end)
                        o.CFrame = SLING_VOID
                        o.AssemblyLinearVelocity = Vector3.zero
                    end
                end
            end)
        end
    end

    -- ============================
    --   RIOT ABUSER
    -- ============================

    if Features.riot and riotRunning and hrp then
        pcall(function()
            local t  = tick() - riotCfg.t0
            local dt2 = dt

            local yaw   = math.rad(riotCfg.spinSpeed * dt2)
            local pitch = math.rad(
                riotCfg.spinSpeed * 0.37 * dt2 * math.sin(t * 3.1)
            )
            local roll  = math.rad(
                riotCfg.spinSpeed * 0.19 * dt2
                * math.cos(t * 5.7 + riotCfg.seed)
            )
            local spinCF = hrp.CFrame * CFrame.Angles(pitch, yaw, roll)

            local spread = riotCfg.distance / 300
            local jX = (math.random() - 0.5)
                        * riotCfg.xJitter * spread * 2
                        + math.noise(t * 9, riotCfg.seed, 0)
                        * riotCfg.xJitter * spread
            local jY = (math.random() - 0.5)
                        * riotCfg.yJitter * spread
                        + math.noise(0, t * 9, riotCfg.seed)
                        * riotCfg.yJitter * spread * 0.3
            local jZ = (math.random() - 0.5)
                        * riotCfg.xJitter * spread * 2
                        + math.noise(0, 0, t * 9 + riotCfg.seed)
                        * riotCfg.xJitter * spread

            local newY  = math.max(spinCF.Position.Y + jY, 2)
            hrp.CFrame  = spinCF
                + Vector3.new(jX, newY - spinCF.Position.Y, jZ)
        end)
    end
end))

