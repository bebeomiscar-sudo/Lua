--   SLINGSHOT BYPASS — OPTIMIZED
--   4 modes: Projectile, Hitscan, Melee, Knife
-- =============================================

local slingshotMode    = "Projectile"
local trackedProj      = {}
local SLING_VOID       = CFrame.new(9000, 9000, 9000)
local slingshotAddConn = nil
local slingshotRemConn = nil
local slingshotScanT   = 0
local SLING_SCAN_RATE  = 0.05

local PROJECTILE_NAMES = {
    "CoreProjectile", "Bullet", "Projectile",
    "Arrow", "Bolt", "Shell", "Pellet",
}

local HITSCAN_NAMES = {
    "HitscanEffect", "LaserBeam", "TracerEffect",
    "RayEffect", "ScanEffect",
}

local MELEE_NAMES = {
    "SlashEffect", "MeleeHitbox", "SwingEffect",
    "AttackBox", "HitEffect",
}

local KNIFE_NAMES = {
    "KnifeProjectile", "ThrowKnife", "DaggerProjectile",
    "BladeEffect",
}

local function matchesMode(name)
    local lname = name:lower()
    local list
    if slingshotMode == "Projectile" then
        list = PROJECTILE_NAMES
    elseif slingshotMode == "Hitscan" then
        list = HITSCAN_NAMES
    elseif slingshotMode == "Melee" then
        list = MELEE_NAMES
    elseif slingshotMode == "Knife" then
        list = KNIFE_NAMES
    else
        list = PROJECTILE_NAMES
    end
    for _, n in ipairs(list) do
        if lname:find(n:lower()) then return true end
    end
    -- Always catch CoreProjectile regardless of mode
    return lname:find("coreprojectile") or lname:find("projectile")
end

local function improvedSlingshotObj(obj)
    pcall(function()
        sethiddenproperty(obj, "CFrame",       SLING_VOID)
        sethiddenproperty(obj, "Transparency",  1)
        sethiddenproperty(obj, "CanCollide",    false)
        sethiddenproperty(obj, "CanTouch",      false)
        sethiddenproperty(obj, "CastShadow",    false)
        sethiddenproperty(obj, "Massless",      true)
    end)
    pcall(function()
        obj.CFrame = SLING_VOID
        obj.AssemblyLinearVelocity  = Vector3.zero
        obj.Transparency = 1
        obj.CanCollide   = false
        obj.CanTouch     = false
    end)
end

local function hookSlingshotProjectiles()
    if slingshotAddConn then return end

    slingshotAddConn = track(workspace.ChildAdded:Connect(function(obj)
        if not Features.slingshot then return end
        if not obj:IsA("BasePart") then return end
        if matchesMode(obj.Name) then
            trackedProj[obj] = true
            improvedSlingshotObj(obj)
        elseif obj.Name == "Part" then
            task.defer(function()
                if obj and obj.Parent
                    and obj.AssemblyLinearVelocity.Magnitude > 50 then
                    trackedProj[obj] = true
                    improvedSlingshotObj(obj)
                end
            end)
        end
    end))

    slingshotRemConn = track(workspace.ChildRemoved:Connect(function(obj)
        trackedProj[obj] = nil
    end))
end

