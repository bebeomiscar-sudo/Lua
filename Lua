--//                  SLINGSHOT PROJECTILE TOUCH
--// ═══════════════════════════════════════════════════════════

local slingshotConn = nil

local function getNearestEnemyHead()
    local hrp = getHRP()
    if not hrp then return nil end
    local best, bestDist = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        local char = plr.Character
        if not char then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        local head = char:FindFirstChild("HitboxHead") or char:FindFirstChild("Head")
        if not head then continue end
        local d = (head.Position - hrp.Position).Magnitude
        if d < bestDist then
            bestDist = d
            best     = head
        end
    end
    return best
end

local function getTargetHead()
    if Config.target.character then
        local char = Config.target.character
        local hum  = char:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then
            return char:FindFirstChild("HitboxHead") or char:FindFirstChild("Head")
        end
    end
    return getNearestEnemyHead()
end

local function startSlingshotTouch()
    if slingshotConn then return end

    slingshotConn = workspace.DescendantAdded:Connect(function(obj)
        -- Match: BasePart or Model named Slingshot / CoreProjectile / OuterProjectile
        local isProjectile = (
            obj.Name == "Slingshot"       or
            obj.Name == "CoreProjectile"  or
            obj.Name == "OuterProjectile"
        )
        if not isProjectile then return end
        if not obj:IsA("BasePart") and not obj:IsA("Model") then return end

        task.spawn(function()
            task.wait(0.05)

            -- Resolve the actual BasePart to touch
            local part = obj:IsA("BasePart") and obj
                or obj:FindFirstChildWhichIsA("BasePart")
            if not part then return end

            pcall(function() part.CanTouch = true end)

            -- Try to touch the target for up to 3 seconds
            for _ = 1, 180 do
                if not part.Parent or not part:IsDescendantOf(workspace) then break end

                local targetHead = getTargetHead()
                if targetHead
                    and targetHead:IsA("BasePart")
                    and targetHead.Parent
                    and targetHead:IsDescendantOf(workspace)
                then
                    pcall(firetouchinterest, targetHead, part, 0)
                    pcall(firetouchinterest, targetHead, part, 1)
                end

                task.wait()
            end
        end)
    end)
end

local function stopSlingshotTouch()
    if slingshotConn then
        slingshotConn:Disconnect()
        slingshotConn = nil
    end
end

