--//                  VOID SNAP (VFR Trick)
--// ═══════════════════════════════════════════════════════════

local vfrSnap = { cf = nil, lv = nil, av = nil }
local LIM, DEAD = 2147483646, 1147483646

local function getHRP()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function clearSnap()
    vfrSnap.cf = nil
    vfrSnap.lv = nil
    vfrSnap.av = nil
end

local function randSkip(mi, ma, dmi, dma)
    local v = math.random(mi, ma)
    while v >= dmi and v <= dma do v = math.random(mi, ma) end
    return v
end

local function snapToVoid()
    local hrp = getHRP()
    if not hrp then return false end
    vfrSnap.cf = hrp.CFrame
    vfrSnap.lv = hrp.AssemblyLinearVelocity
    vfrSnap.av = hrp.AssemblyAngularVelocity
    pcall(function()
        local p = Vector3.new(
            randSkip(-LIM, LIM, -DEAD, DEAD),
            randSkip(-LIM, LIM, -DEAD, DEAD),
            randSkip(-LIM, LIM, -DEAD, DEAD)
        )
        hrp.CFrame = CFrame.new(p) * CFrame.Angles(math.pi, math.pi, math.pi)
        hrp.AssemblyLinearVelocity  = p
        hrp.AssemblyAngularVelocity = p
    end)
    return true
end

local function restoreFromVoid()
    local hrp = getHRP()
    if not hrp or not vfrSnap.cf then return end
    pcall(function()
        hrp.CFrame = vfrSnap.cf
        hrp.AssemblyLinearVelocity  = vfrSnap.lv
        hrp.AssemblyAngularVelocity = vfrSnap.av
    end)
    clearSnap()
end

RunService:BindToRenderStep("hvh_vfr", Enum.RenderPriority.First.Value, function()
    if not vfrSnap.cf then return end
    local hrp = getHRP()
    if not hrp then return end
    pcall(function()
        hrp.CFrame = vfrSnap.cf
        hrp.AssemblyLinearVelocity  = vfrSnap.lv
        hrp.AssemblyAngularVelocity = vfrSnap.av
    end)
end)

