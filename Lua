    autoTP      = false,
    autoTarget  = nil,
    autoDelay   = 1,
    onlyInGame  = true, -- VisibleCheck: skip lobby players
}

local autoTPThread = nil

-- =============================================
--   Visible Check — is player in game (not lobby)
-- =============================================

local function isPlayerInGame(player)
    if not tpConfig.onlyInGame then return true end
    if player == lp then return false end

    local char = player.Character
    if not char then return false end

    -- Check humanoid exists and is alive
    local hum = char:FindFirstChildWhichIsA("Humanoid")
    if not hum then return false end
    if hum.Health <= 0 then return false end

    -- Check character is in workspace (not lobby area)
    if not char:IsDescendantOf(workspace) then return false end

    -- Check HRP exists
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    -- Check player is visible (not too far = lobby spawn)
    local myChar = lp.Character
    if myChar then
        local myHRP = myChar:FindFirstChild("HumanoidRootPart")
        if myHRP then
            local dist = (myHRP.Position - hrp.Position).Magnitude
            -- If more than 5000 studs they are probably in lobby
            if dist > 5000 then return false end
        end
    end

    return true
end

local function teleportToPlayer(player)
    if not isPlayerInGame(player) then
        Library:Notify("⚠️ " .. player.Name .. " is in lobby — skipped!", 3)
        return false
    end

    local char    = player.Character
    local myChar  = lp.Character
    if not char or not myChar then return false end

    local targetHRP = char:FindFirstChild("HumanoidRootPart")
    local myHRP     = myChar:FindFirstChild("HumanoidRootPart")
    if not targetHRP or not myHRP then return false end

    -- TP to player head position
    local headOffset = Vector3.new(0, 3, 0)
    myHRP.CFrame = CFrame.new(targetHRP.Position + headOffset)
    Library:Notify("Teleported to " .. player.Name, 2)
    return true
end

