-- Smart Riot: raises shield when a projectile is incoming
local smartRiotConn = nil
local godmodeConn   = nil

local function startSmartRiot()
    if smartRiotConn then return end

    smartRiotConn = workspace.DescendantAdded:Connect(function(obj)
        if not Config.smartRiot.enabled then return end

        -- Detect incoming projectiles (not ours)
        local isProjectile = (
            obj.Name == "CoreProjectile"  or
            obj.Name == "OuterProjectile" or
            obj.Name == "Slingshot"       or
            obj.Name:lower():find("projectile", 1, true) or
            obj.Name:lower():find("bullet",     1, true) or
            obj.Name:lower():find("arrow",      1, true)
        )
        if not isProjectile then return end
        if not (obj:IsA("BasePart") or obj:IsA("Model")) then return end

        task.spawn(function()
            local part = obj:IsA("BasePart") and obj
                or obj:FindFirstChildWhichIsA("BasePart")
            if not part then return end

            local myHRP = getHRP()
            if not myHRP then return end

            -- Check if it's heading toward us
            -- Track for up to 2 seconds
            for _ = 1, 120 do
                if not part.Parent then break end
                if not Config.smartRiot.enabled then break end

                local dist = (part.Position - myHRP.Position).Magnitude

                -- If projectile is within 30 studs and closing in → block
                if dist < 30 then
                    -- Raise shield via UseItem
                    fireRiotBlock()

                    -- Also block via hide phase during voidspam
                    if Config.void.enabled and Config.void.phase == "shoot" then
                        Config.void.phase = "hide"
                    end
                    break
                end
                task.wait()
            end
        end)
    end)
end

local function stopSmartRiot()
    if smartRiotConn then
        smartRiotConn:Disconnect()
        smartRiotConn = nil
    end
end

--// Riot Godmode: spam-fires shield UseItem every frame
local function startRiotGodmode()
    if godmodeConn then return end
    equipRiot()
    godmodeConn = RunService.Heartbeat:Connect(function()
        if not Config.riotGodmode.enabled then
            godmodeConn:Disconnect()
            godmodeConn = nil
            lowerRiot()
            return
        end
        fireRiotBlock()
    end)
end

local function stopRiotGodmode()
    if godmodeConn then
        godmodeConn:Disconnect()
        godmodeConn = nil
    end
    lowerRiot()
end

--// Block incoming touchinterest from projectiles
local function installProjectileBlocker()
    -- Hook DescendantAdded for workspace to detect ALL projectiles
    workspace.DescendantAdded:Connect(function(obj)
        if not Config.riotGodmode.enabled then return end
        local isProj = (
            obj.Name == "CoreProjectile"  or
            obj.Name == "OuterProjectile" or
            obj.Name == "Slingshot"
        )
        if not isProj then return end
        if not (obj:IsA("BasePart") or obj:IsA("Model")) then return end

        task.spawn(function()
            local part = obj:IsA("BasePart") and obj
                or obj:FindFirstChildWhichIsA("BasePart")
            if not part then return end

            local myChar = LocalPlayer.Character
            if not myChar then return end

            -- Wait a tick then disable touch on our character's parts
            task.wait(0.02)
            for _, charPart in ipairs(myChar:GetDescendants()) do
                if charPart:IsA("BasePart") then
                    -- Use firetouchinterest in reverse to simulate block
                    -- The godmode fires shield UseItem which server-side blocks
                    pcall(function()
                        -- Make projectile "touch" our riot shield instead
                        local shieldPart = LocalPlayer.Character
                            and LocalPlayer.Character:FindFirstChild("RiotShield")
                            or LocalPlayer.Character:FindFirstChild("Shield")
                        if shieldPart and shieldPart:IsA("BasePart") then
                            firetouchinterest(shieldPart, part, 0)
                            firetouchinterest(shieldPart, part, 1)
                        end
                    end)
                end
            end
        end)
    end)
end

installProjectileBlocker()

