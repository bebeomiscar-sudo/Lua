--// Mirrors _UpdateUnequippedViewModel from modelscript
local function updateUnequippedViewModel()
    if not RiotState.shieldAttached or RiotState.updateQueued then return end
    RiotState.updateQueued = true

    task.delay(0.1, function()
        RiotState.updateQueued = false
        local lf = getLF()
        if not lf then return end

        pcall(function()
            -- Mirrors: check IsEquipped + IsActuallyFirstPerson
            local isThirdPerson = not (lf.IsEquipped or false)
            if isThirdPerson and lf.Entity and lf.Entity.Model then
                local upperTorso = lf.Entity.Model:FindFirstChild("UpperTorso")
                if upperTorso and RiotState.unequippedViewModel then
                    -- Re-weld shield to back (unequipped position)
                    local uvm = RiotState.unequippedViewModel
                    if uvm.BreakWeld then uvm:BreakWeld(upperTorso) end
                    if uvm.PivotTo   then uvm:PivotTo(upperTorso.CFrame, "_riot_shield_back") end
                    if uvm.WeldTo    then uvm:WeldTo(upperTorso) end
                end
            end
        end)
    end)
end

--// Mirrors _AttachUnequippedViewModel from modelscript
local function attachUnequippedViewModel()
    if RiotState.shieldAttached then return end
    local lf = getLF()
    if not lf or not lf.Entity then return end

    pcall(function()
        local model = lf.Entity.Model
        if not model then return end
        local upperTorso = model:FindFirstChild("UpperTorso")
        if upperTorso and lf:IsAlive() then
            RiotState.shieldAttached = true

            -- Create static view model (mirrors _Setup)
            if Modules.StaticViewModel then
                RiotState.unequippedViewModel = Modules.StaticViewModel.new("RiotShield_Back")
                pcall(function()
                    RiotState.unequippedViewModel:SetArchivable(false)
                    RiotState.unequippedViewModel:PivotTo(upperTorso.CFrame, "_riot_shield_back")
                    RiotState.unequippedViewModel:WeldTo(upperTorso)
                end)
            end

            updateUnequippedViewModel()
        end
    end)
end

--// Mirrors ReplicateFromServer AbsorbedHit
local function triggerAbsorbAnim()
    if not Config.shield.absorbAnim then return end
    Config.shield.lastAbsorb = tick()

    local lf = getLF()
    if not lf then return end

    pcall(function()
        local item = getRiotItem()
        if not item then return end

        -- Trigger AbsorbedHit visual (impulse on viewmodel)
        if item.ViewModel then
            if item.ViewModel.Impulse then
                item.ViewModel:Impulse(Vector3.new(0, -20, 0), 1, nil, true)
            end
            if item.ViewModel.AbsorbedHit then
                item.ViewModel:AbsorbedHit()
            end
        end

        -- Server replicate
        local oid = getRiotOID()
        if oid then
            pcall(function()
                local ev = Modules.Enums:ToEnum("AbsorbedHit")
                if ev then UseItemRemote:FireServer(oid, ev, nil, nil) end
            end)
        end
    end)
end

--// Fire riot shield block UseItem
local lastRiotFire = 0
local function fireRiotBlock()
    local oid = getRiotOID()
    if not oid then return end

    local now = tick()
    if now - lastRiotFire < Config.riotGodmode.spamRate then return end
    lastRiotFire = now

    RiotState.isBlocking = true

    -- Try all known blocking enums
    for _, enumName in ipairs({
        "StartBlocking","Block","Shield","Defend",
        "RaiseShield","Use","StartUsing","BlockStart","HoldShield"
    }) do
        pcall(function()
            local ev = Modules.Enums:ToEnum(enumName)
            if ev then UseItemRemote:FireServer(oid, ev, nil, nil) end
        end)
    end

    -- Also call RiotShield module directly (from source)
    pcall(function()
        if Modules.RiotShield then
            local rs = Modules.RiotShield
            if rs.StartBlock then rs:StartBlock() end
            if rs.Block      then rs:Block()      end
            if rs.Raise      then rs:Raise()      end
        end
    end)
end

local function lowerRiotShield()
    local oid = getRiotOID()
    if not oid then return end
    RiotState.isBlocking = false

    for _, enumName in ipairs({
        "StopBlocking","Unblock","LowerShield",
        "StopUsing","Stop","BlockStop","HoldShieldOff"
    }) do
        pcall(function()
            local ev = Modules.Enums:ToEnum(enumName)
            if ev then UseItemRemote:FireServer(oid, ev, nil, nil) end
        end)
    end
end

local function equipRiotShield()
    local item = getRiotItem()
    if not item then return false end
    local oid = getItemOID(item)
    if not oid then return false end
    equipByOID(oid)
    local lf = getLF()
    pcall(function()
        if lf and lf.EquipItem then lf:EquipItem(2) end
    end)
    pressSlot(2)
    attachUnequippedViewModel()
    return true
end

--// Smart Riot: detect incoming projectile and block
local function startSmartRiot()
    if RiotState.smartConn then return end

    RiotState.smartConn = workspace.DescendantAdded:Connect(function(obj)
        if not Config.smartRiot.enabled then return end

        local isProj = (
            obj.Name == "CoreProjectile"  or
            obj.Name == "OuterProjectile" or
            obj.Name == "Slingshot"       or
            obj.Name:lower():find("projectile", 1, true) ~= nil or
            obj.Name:lower():find("bullet",     1, true) ~= nil or
            obj.Name:lower():find("arrow",      1, true) ~= nil
        )
        if not isProj then return end
        if not (obj:IsA("BasePart") or obj:IsA("Model")) then return end

        task.spawn(function()
            local part = obj:IsA("BasePart") and obj
                or obj:FindFirstChildWhichIsA("BasePart")
            if not part then return end

            local myHRP = getHRP()
            if not myHRP then return end

            for _ = 1, 120 do
                if not part.Parent then break end
                if not Config.smartRiot.enabled then break end

                local dist = (part.Position - myHRP.Position).Magnitude

                if dist < (Config.smartRiot.detectRange or 30) then
                    -- Equip riot if needed
                    if Config.smartRiot.autoEquip then
                        equipRiotShield()
                    end

                    -- Raise shield via UseItem
                    fireRiotBlock()

                    -- Trigger absorb animation (from modelscript)
                    triggerAbsorbAnim()

                    -- Also redirect projectile touch to shield
                    pcall(function()
                        local myChar  = LocalPlayer.Character
                        local shield  = myChar and (
                            myChar:FindFirstChild("RiotShield") or
                            myChar:FindFirstChild("Shield")     or
                            myChar:FindFirstChild("Riot Shield")
                        )
                        if shield and shield:IsA("BasePart") then
                            firetouchinterest(shield, part, 0)
                            firetouchinterest(shield, part, 1)
                        end
                    end)
                    break
                end
                task.wait()
            end
        end)
    end)
end

local function stopSmartRiot()
    if RiotState.smartConn then
        RiotState.smartConn:Disconnect()
        RiotState.smartConn = nil
    end
    lowerRiotShield()
end

--// Riot Godmode: spam block every frame
local function startRiotGodmode()
    if RiotState.godmodeConn then return end
    if Config.riotGodmode.forceEquip then
        equipRiotShield()
    end
    RiotState.godmodeConn = RunService.Heartbeat:Connect(function()
        if not Config.riotGodmode.enabled then
            RiotState.godmodeConn:Disconnect()
            RiotState.godmodeConn = nil
            if Config.riotGodmode.unequipAfter then
                lowerRiotShield()
                -- Re-equip current weapon
                forceEquipWeapon(Config.weapon.mode)
            end
            return
        end
        fireRiotBlock()
    end)
end

local function stopRiotGodmode()
    Config.riotGodmode.enabled = false
    if RiotState.godmodeConn then
        RiotState.godmodeConn:Disconnect()
        RiotState.godmodeConn = nil
    end
    lowerRiotShield()
    if Config.riotGodmode.unequipAfter then
        forceEquipWeapon(Config.weapon.mode)
    end
end

