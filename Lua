-- =============================================
--   Safe Require Helper
-- =============================================

local function safeRequire(path)
    local ok, result = pcall(require, path)
    if ok then return result end
    return nil
end

-- =============================================
--   Require Modules
-- =============================================

local FighterController = safeRequire(lp.PlayerScripts:WaitForChild("Controllers"):WaitForChild("FighterController"))
local EnumLibrary       = safeRequire(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("EnumLibrary"))
local Utility           = safeRequire(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Utility"))

local RiotShieldModule  = safeRequire(
    lp.PlayerScripts:WaitForChild("Modules"):WaitForChild("Items"):WaitForChild("Riot Shield")
)

local CollectEffect     = safeRequire(
    lp.PlayerScripts:WaitForChild("Modules"):WaitForChild("Functions"):WaitForChild("CollectEffect")
)

-- =============================================
--   FIX #1 — Hook ReplicateUnreliable OnClientEvent
--   This was causing the "event dropped" error
--   and your friend's lag/not working issue
-- =============================================

local ReplicateUnreliable = ReplicatedStorage
    :WaitForChild("Remotes")
    :WaitForChild("Replication")
    :WaitForChild("Fighter")
    :FindFirstChild("ReplicateUnreliable")

if ReplicateUnreliable then
    -- Properly handle incoming unreliable events
    -- so the server doesn't drop/discard them
    ReplicateUnreliable.OnClientEvent:Connect(function(...)
        -- Silently consume the event
        -- This stops the "did you forget to implement OnClientEvent?" error
        -- and prevents the lag spike from event queue buildup
    end)
end

-- =============================================
--   Remote References (cached, not re-fetched every frame)
-- =============================================

local UseItemRemote = ReplicatedStorage
    :WaitForChild("Remotes")
    :WaitForChild("Replication")
    :WaitForChild("Fighter")
    :WaitForChild("UseItem")

-- =============================================
--   FIX #2 — Throttle Rate
--   Instead of every Heartbeat (~60/s) we fire
--   every 0.1s which is plenty to hold block state
--   without spamming the server and causing lag
-- =============================================

local BLOCK_RATE     = 0.12  -- seconds between each FireServer (was 0 = every frame = lag)
local lastBlockFire  = 0

-- =============================================
--   Helpers
-- =============================================

local function getRiotShield()
    if not FighterController then return nil end

    local fighter = FighterController.LocalFighter
    if not fighter then return nil end

    -- Check equipped item first
    if fighter.EquippedItem and fighter.EquippedItem.Name == "Riot Shield" then
        return fighter.EquippedItem
    end

    -- Search items table
    if fighter.Items then
        for _, item in pairs(fighter.Items) do
            if item.Name == "Riot Shield" then
                return item
            end
        end
    end

    -- Search FighterController.Objects
    if FighterController.Objects then
        for _, fighterObj in pairs(FighterController.Objects) do
            if fighterObj.Player == lp and fighterObj.Items then
                for _, item in pairs(fighterObj.Items) do
                    if item.Name == "Riot Shield" then
                        return item
                    end
                end
            end
        end
    end

    return nil
end

local function playShieldEffect(color)
    if not CollectEffect then return end
    local char = lp.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    pcall(CollectEffect,
        hrp.Position + Vector3.new(0, 2, 0),
        color or Color3.fromRGB(80, 160, 255),
        nil,
        1.5
    )
end

-- =============================================
--   Godmode State
-- =============================================

local Godmode = {
    Enabled    = false,
    BlockConn  = nil,
    HealthConn = nil,
    LastHealth = nil,
}

-- =============================================
--   FIX #3 — Block Loop with Throttle
--   No longer fires every single frame
--   Uses delta time accumulation instead
-- =============================================

local function startBlockLoop()
    if Godmode.BlockConn then
        Godmode.BlockConn:Disconnect()
        Godmode.BlockConn = nil
    end

    local accum = 0

    Godmode.BlockConn = RunService.Heartbeat:Connect(function(dt)
        if not Godmode.Enabled then return end

        accum = accum + dt

        -- Only fire every BLOCK_RATE seconds
        if accum < BLOCK_RATE then return end
        accum = 0

        local shield = getRiotShield()
        if not shield then return end

        local objectID
        local ok = pcall(function()
            objectID = shield:Get("ObjectID")
        end)
        if not ok or not objectID then return end

        -- FIX #4 — Use FireServer safely with proper enum
        -- Wrapped to prevent any errors from crashing the loop
        pcall(function()
            UseItemRemote:FireServer(
                objectID,
                EnumLibrary:ToEnum("StartAiming"),
                {},
                nil
            )
        end)
    end)
end

-- =============================================
--   FIX #5 — Health Hook with proper nil checks
-- =============================================

local function hookHealthChanged(fighter)
    if not fighter then return end

    if Godmode.HealthConn then
        Godmode.HealthConn:Disconnect()
        Godmode.HealthConn = nil
    end

    local ok, hp = pcall(function()
        return fighter:Get("Health")
    end)
    Godmode.LastHealth = (ok and hp) or 100

    -- FIX: Check the signal exists before connecting
    if not fighter.HealthChanged then return end

    Godmode.HealthConn = fighter.HealthChanged:Connect(function()
        if not Godmode.Enabled then return end

        local currentHealth
        local ok2, result = pcall(function()
            return fighter:Get("Health")
        end)
        currentHealth = (ok2 and result) or 100

        if currentHealth < (Godmode.LastHealth or currentHealth) then
            local shield = getRiotShield()

            -- Trigger AbsorbedHit visual
            pcall(function()
                local localFighterObj = FighterController:GetFighter(lp)
                if localFighterObj and localFighterObj.Items then
                    for _, item in pairs(localFighterObj.Items) do
                        if item.Name == "Riot Shield" then
                            item:ReplicateFromServer("AbsorbedHit")
                            break
                        end
                    end
                end
            end)

            -- FIX #6 — Re-block: use task.defer instead of task.wait()
            -- task.wait() with no arg can cause inconsistent timing
            if shield then
                pcall(function()
                    local objectID = shield:Get("ObjectID")

                    UseItemRemote:FireServer(
                        objectID,
                        EnumLibrary:ToEnum("StopAiming"),
                        {}, nil
                    )

                    -- defer to next frame instead of task.wait()
                    task.defer(function()
                        pcall(function()
                            UseItemRemote:FireServer(
                                objectID,
                                EnumLibrary:ToEnum("StartAiming"),
                                {}, nil
                            )
                        end)
                    end)
                end)
            end

            playShieldEffect(Color3.fromRGB(80, 160, 255))

        else
            playShieldEffect(Color3.fromRGB(80, 255, 120))
        end

        Godmode.LastHealth = currentHealth
    end)
end

-- =============================================
--   Start / Stop Godmode
-- =============================================

local function startGodmode()
    local shield = getRiotShield()

    if not shield then
        Rayfield:Notify({
            Title   = "Riot Shield Required",
            Content = "Equip the Riot Shield in your loadout first!",
            Duration = 4,
            Image   = 4483362458,
        })
        return false
    end

    if not FighterController then
        Rayfield:Notify({
            Title   = "Module Error",
            Content = "FighterController failed to load.",
            Duration = 4,
            Image   = 4483362458,
        })
        return false
    end

    Godmode.Enabled = true

    -- Hook health in background
    task.spawn(function()
        local ok, fighter = pcall(function()
            return FighterController:WaitForLocalFighter()
        end)
        if ok and fighter then
            hookHealthChanged(fighter)
        end
    end)

    startBlockLoop()
    playShieldEffect(Color3.fromRGB(255, 255, 100))

    Rayfield:Notify({
        Title   = "🛡️ Godmode Active",
        Content = "Riot Shield blocking all damage. Lag fixed!",
        Duration = 3,
        Image   = 4483362458,
    })
    return true
end

local function stopGodmode()
    Godmode.Enabled = false

    if Godmode.BlockConn then
        Godmode.BlockConn:Disconnect()
        Godmode.BlockConn = nil
    end

    if Godmode.HealthConn then
        Godmode.HealthConn:Disconnect()
        Godmode.HealthConn = nil
    end

    Rayfield:Notify({
        Title   = "Godmode Off",
        Content = "Shield godmode deactivated.",
        Duration = 3,
        Image   = 4483362458,
    })
end

-- =============================================
--   Respawn Handler
-- =============================================

lp.CharacterAdded:Connect(function()
    if not Godmode.Enabled then return end

    task.wait(1.5) -- wait for character to fully load

    local ok, fighter = pcall(function()
        return FighterController:WaitForLocalFighter()
    end)

    if ok and fighter then
        hookHealthChanged(fighter)
    end

    startBlockLoop()
    playShieldEffect(Color3.fromRGB(255, 255, 100))
end)

