RunService.RenderStepped:Connect(function()
    local center    = Camera.ViewportSize / 2
    local myHRP     = getHRP()
    local hasTarget = Config.target.enabled
        and Config.target.character
        and Config.target.character.Parent ~= nil

    --// FOV Circle
    local showFov = Config.visuals.fovCircle and Config.void.enabled
    fovCircle.Visible  = showFov
    fovOutline.Visible = showFov
    if showFov then
        fovCircle.Position  = center ; fovCircle.Radius   = Config.void.fovSize ; fovCircle.Color = Config.visuals.fovColor
        fovOutline.Position = center ; fovOutline.Radius  = Config.void.fovSize
    end

    --// Target indicator + tracer
    if hasTarget and Config.visuals.indicator then
        local hitPart = getHitPart(Config.target.character, Config.void.hitpart)
        if hitPart then
            local sp, onScreen = Camera:WorldToViewportPoint(hitPart.Position)
            if onScreen then
                local sv = Vector2.new(sp.X, sp.Y)
                local col = Config.void.phase == "hide"
                    and Color3.fromRGB(255,165,0)
                    or  Config.visuals.espColor
                tDot.Position    = sv ; tDot.Color   = col ; tDot.Visible    = true
                tDotOut.Position = sv ;                      tDotOut.Visible = true

                if Config.visuals.tracer then
                    local from = Vector2.new(center.X, Camera.ViewportSize.Y)
                    tracerLine.From = from ; tracerLine.To = sv ; tracerLine.Color = Config.visuals.tracerColor ; tracerLine.Visible = true
                    tracerOut.From  = from ; tracerOut.To  = sv ;                                                 tracerOut.Visible  = true
                else
                    tracerLine.Visible = false ; tracerOut.Visible = false
                end
            else
                tDot.Visible = false ; tDotOut.Visible = false
                tracerLine.Visible = false ; tracerOut.Visible = false
            end
        end
    else
        tDot.Visible = false ; tDotOut.Visible = false
        tracerLine.Visible = false ; tracerOut.Visible = false
    end

    --// ESP
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        local e    = ESPData[plr]
        if not e then continue end
        local char = plr.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        local head = char and char:FindFirstChild("Head")
        if not Config.visuals.esp or not hrp or not hum or not head then
            for k, d in pairs(e) do if typeof(d) ~= "number" then pcall(function() d.Visible = false end) end end
            continue
        end
        local rootSP, vis = Camera:WorldToViewportPoint(hrp.Position)
        local headSP      = Camera:WorldToViewportPoint(head.Position + Vector3.new(0,0.5,0))
        if not vis then
            for k, d in pairs(e) do if typeof(d) ~= "number" then pcall(function() d.Visible = false end) end end
            continue
        end
        local dist  = myHRP and math.floor((hrp.Position - myHRP.Position).Magnitude) or 0
        local hDiff = math.abs(rootSP.Y - headSP.Y)
        local w     = hDiff * 0.6
        local bx    = rootSP.X - w/2
        local by    = headSP.Y
        local bh    = hDiff * 1.1
        local isTarget = Config.target.character == char
        local col   = isTarget and Color3.fromRGB(255,165,0) or Config.visuals.espColor
        e.box.Size     = Vector2.new(w,bh) ; e.box.Position    = Vector2.new(bx,by) ; e.box.Color  = col ; e.box.Visible = true
        e.boxOut.Size  = Vector2.new(w,bh) ; e.boxOut.Position = Vector2.new(bx,by) ; e.boxOut.Visible = true
        e.name.Text    = plr.DisplayName   ; e.name.Position   = Vector2.new(rootSP.X, by-15) ; e.name.Color = col ; e.name.Visible = true
        e.dist.Text    = dist.."m"         ; e.dist.Position   = Vector2.new(rootSP.X, by+bh+2) ; e.dist.Visible = true
        local hp   = hum.Health / math.max(hum.MaxHealth, 1)
        local bW   = 4 ; local bX = bx - 7
        e.hpBg.Size   = Vector2.new(bW,bh)     ; e.hpBg.Position   = Vector2.new(bX,by)             ; e.hpBg.Visible   = true
        e.hpFill.Size = Vector2.new(bW,bh*hp)  ; e.hpFill.Position = Vector2.new(bX,by+bh-bh*hp)    ; e.hpFill.Visible = true
        e.hpFill.Color= Color3.fromRGB(255*(1-hp),255*hp,0)
        local prevHP = e._hp or hum.Health
        if hum.Health < prevHP then
            local dmg = math.floor(prevHP - hum.Health)
            if dmg > 0 then pushNotif(string.format("💥 %s  -%dhp  (%.0f left)", plr.Name, dmg, hum.Health)) end
        end
        e._hp = hum.Health
    end

    --// Status HUD
    if Config.visuals.statusHUD then
        local anchor   = center + Vector2.new(0, 45)
        local phase    = Config.void.phase or "off"
        local weaponNm = Config.weapon.mode
        local targetNm = Config.target.player and Config.target.player.Name or "none"
        local riotTxt  = Config.riotGodmode.enabled and " | 🛡️GODMODE"
            or Config.smartRiot.enabled and " | 🛡️smart" or ""

        hud1.Text     = "voidspam: " .. phase .. riotTxt
        hud1.Color    = phase == "hide" and Color3.fromRGB(255,165,0) or Config.visuals.statusColor
        hud1.Position = anchor ; hud1.Visible = Config.void.enabled

        hud2.Text     = "weapon: " .. weaponNm .. " | target: " .. targetNm
        hud2.Position = anchor + Vector2.new(0,16) ; hud2.Visible = Config.void.enabled

        hud3.Text     = "weapon in hand: " .. getCurrentWeaponName()
        hud3.Position = anchor + Vector2.new(0,30) ; hud3.Visible = Config.void.enabled

        -- Phase label top center
        if Config.void.enabled then
            phaseLabel.Text     = phase == "hide" and "[ HIDING ]" or "[ SHOOTING ]"
            phaseLabel.Color    = phase == "hide" and Color3.fromRGB(255,165,0) or Color3.fromRGB(0,255,100)
            phaseLabel.Position = Vector2.new(center.X, 30)
            phaseLabel.Visible  = true
        else
            phaseLabel.Visible = false
        end

        -- Shield indicator
        if RiotState.isBlocking then
            shieldLabel.Text     = "🛡️ SHIELD ACTIVE"
            shieldLabel.Position = Vector2.new(center.X, 50)
            shieldLabel.Visible  = true
        else
            shieldLabel.Visible = false
        end
    else
        hud1.Visible = false ; hud2.Visible = false ; hud3.Visible = false
        phaseLabel.Visible = false ; shieldLabel.Visible = false
    end

    --// Hit notifs
    local now = tick() ; local toRm = {}
    for i, n in ipairs(HitNotifs) do
        local el = now - n.t
        n.lbl.Transparency = 1 - math.clamp((el - (n.dur-0.5))/0.5, 0, 1)
        n.lbl.Position     = Vector2.new(12, 12 + (i-1)*18)
        if el >= n.dur then table.insert(toRm, i) end
    end
    for i = #toRm, 1, -1 do
        pcall(function() HitNotifs[toRm[i]].lbl:Remove() end)
        table.remove(HitNotifs, toRm[i])
    end
end)

