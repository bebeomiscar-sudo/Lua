-- =============================================
--   EVASION SYSTEM
-- =============================================

local evasionConn   = nil
local evasionActive = false
local lastRepos     = 0
local lastFwdPhase  = 0
local lastUpPhase   = 0
local hsFlip        = false
local mlFlip        = false

local evasionCfg = {
    mode             = "Off",
    baseRadius       = 500,
    randomRange      = 1.0,
    depthForward     = 0,
    depthForwardFreq = 10,
    depthUp          = 0,
    depthUpFreq      = 30,
    reposInterval    = 0.5,
    fallbackRadius   = 500,
    fallbackRandom   = 1.0,
    offset           = 0,
    hsDown           = 1.0,
    hsUp             = 1.0,
    mlDown           = 1.0,
    mlUp             = 1.0,
}

local function findNearestProjectile(hrp)
    local best, bd = nil, math.huge
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("BasePart") then
            local n = obj.Name:lower()
            if n:find("projectile") or n:find("bullet")
                or n:find("core") then
                local d = (obj.Position - hrp.Position).Magnitude
                if d < bd then bd = d; best = obj end
            end
        end
    end
    return best
end

local function startEvasionMode()
    if evasionConn then evasionConn:Disconnect(); evasionConn = nil end
    if evasionCfg.mode == "Off" then return end
    evasionActive = true

    evasionConn = RunService.Heartbeat:Connect(function(dt)
        if not evasionActive then return end
        local char = lp.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local mode = evasionCfg.mode

        if mode == "Random" then
            local r     = evasionCfg.baseRadius * evasionCfg.randomRange
            local angle = math.random() * math.pi * 2
            hrp.CFrame  = CFrame.new(
                hrp.Position.X + math.cos(angle) * r,
                hrp.Position.Y + (math.random() - 0.5) * r * 0.3,
                hrp.Position.Z + math.sin(angle) * r
            )
        elseif mode == "ProjectileMimic" then
            local now = tick()
            if now - lastRepos >= evasionCfg.reposInterval then
                lastRepos = now
                local proj = findNearestProjectile(hrp)
                if proj then
                    lastFwdPhase += dt * evasionCfg.depthForwardFreq
                    lastUpPhase  += dt * evasionCfg.depthUpFreq
                    local fwd = math.sin(lastFwdPhase)
                                * evasionCfg.depthForward
                    local up  = math.sin(lastUpPhase)
                                * evasionCfg.depthUp
                    local pCF = proj.CFrame
                    hrp.CFrame = CFrame.new(
                        proj.Position + pCF.LookVector * fwd
                        + pCF.UpVector * up
                    )
                else
                    local r     = evasionCfg.fallbackRadius
                                * evasionCfg.fallbackRandom
                    local angle = math.random() * math.pi * 2
                    hrp.CFrame  = CFrame.new(
                        hrp.Position.X + math.cos(angle) * r,
                        hrp.Position.Y + (math.random()-0.5)*r*0.2,
                        hrp.Position.Z + math.sin(angle) * r
                    )
                end
            end
        elseif mode == "Translocate" then
            hrp.CFrame = hrp.CFrame
                + hrp.CFrame.LookVector * evasionCfg.offset
        elseif mode == "Hitscan Strategy" then
            hsFlip = not hsFlip
            hrp.CFrame = hrp.CFrame + Vector3.new(
                0, hsFlip and -evasionCfg.hsDown or evasionCfg.hsUp, 0
            )
        elseif mode == "Melee Strategy" then
            mlFlip = not mlFlip
            hrp.CFrame = hrp.CFrame + Vector3.new(
                0, mlFlip and -evasionCfg.mlDown or evasionCfg.mlUp, 0
            )
        end
    end)
end

local function stopEvasionMode()
    evasionActive = false
    if evasionConn then evasionConn:Disconnect(); evasionConn = nil end
end

