        -- =============================================
        --   WIDGET BUILDERS
        -- =============================================

        local Section = {}

        -- TOGGLE
        function Section:AddToggle(cfg)
            -- cfg: { Name, Flag, Default, Callback }
            local defaultVal = getConfig(cfg.Flag, cfg.Default or false)

            local row = Instance.new("Frame", itemContainer)
            row.Size             = UDim2.new(1, 0, 0, 30)
            row.BackgroundColor3 = Theme.Bg
            row.BorderSizePixel  = 0
            corner(row, 5)

            makeLabel(
                row, cfg.Name,
                UDim2.new(1, -50, 1, 0),
                Theme.Text, Theme.FontSm
            ).Position = UDim2.new(0, 10, 0, 0)

            local pill = Instance.new("Frame", row)
            pill.Size             = UDim2.fromOffset(36, 18)
            pill.Position         = UDim2.new(1, -44, 0.5, -9)
            pill.BackgroundColor3 = defaultVal
                and Theme.Toggle_ON or Theme.Toggle_OFF
            pill.BorderSizePixel  = 0
            corner(pill, 9)

            local knob = Instance.new("Frame", pill)
            knob.Size             = UDim2.fromOffset(12, 12)
            knob.Position         = defaultVal
                and UDim2.new(1, -15, 0.5, -6)
                or  UDim2.new(0, 3, 0.5, -6)
            knob.BackgroundColor3 = Theme.Text
            knob.BorderSizePixel  = 0
            corner(knob, 6)

            local enabled = defaultVal

            local function applyState(v)
                enabled = v
                tween(pill, {
                    BackgroundColor3 = v and Theme.Toggle_ON or Theme.Toggle_OFF
                }, 0.15)
                tween(knob, {
                    Position = v
                        and UDim2.new(1, -15, 0.5, -6)
                        or  UDim2.new(0, 3, 0.5, -6)
                }, 0.15)
                setConfig(cfg.Flag, v)
                if autoSaveEnabled then saveConfig() end
                if cfg.Callback then cfg.Callback(v) end
            end

            -- Make row clickable
            local btn = Instance.new("TextButton", row)
            btn.Size                  = UDim2.new(1, 0, 1, 0)
            btn.BackgroundTransparency = 1
            btn.Text                  = ""
            btn.ZIndex                = 2

            btn.MouseButton1Click:Connect(function()
                applyState(not enabled)
            end)

            -- Apply default if true
            if defaultVal and cfg.Callback then
                task.defer(function()
                    cfg.Callback(defaultVal)
                end)
            end

            return {
                SetValue = applyState,
                GetValue = function() return enabled end,
            }
        end

        -- SLIDER
        function Section:AddSlider(cfg)
            -- cfg: { Name, Flag, Min, Max, Default, Suffix, Callback }
            local defaultVal = getConfig(cfg.Flag,
                math.clamp(cfg.Default or cfg.Min, cfg.Min, cfg.Max))

            local row = Instance.new("Frame", itemContainer)
            row.Size             = UDim2.new(1, 0, 0, 46)
            row.BackgroundColor3 = Theme.Bg
            row.BorderSizePixel  = 0
            corner(row, 5)

            local nameLbl = makeLabel(
                row, cfg.Name,
                UDim2.new(0.6, 0, 0, 20),
                Theme.Text, Theme.FontSm
            )
            nameLbl.Position = UDim2.new(0, 10, 0, 4)

            local valLbl = makeLabel(
                row,
                tostring(defaultVal) .. (cfg.Suffix or ""),
                UDim2.new(0.4, -10, 0, 20),
                Theme.Accent, Theme.Font,
                Enum.TextXAlignment.Right
            )
            valLbl.Position = UDim2.new(0.6, 0, 0, 4)

            local track = Instance.new("Frame", row)
            track.Size             = UDim2.new(1, -20, 0, 6)
            track.Position         = UDim2.new(0, 10, 0, 30)
            track.BackgroundColor3 = Theme.Slider_Bg
            track.BorderSizePixel  = 0
            corner(track, 3)

            local fill = Instance.new("Frame", track)
            local startPct = (defaultVal - cfg.Min) / (cfg.Max - cfg.Min)
            fill.Size             = UDim2.new(startPct, 0, 1, 0)
            fill.BackgroundColor3 = Theme.Slider_Fill
            fill.BorderSizePixel  = 0
            corner(fill, 3)

            local thumb = Instance.new("Frame", track)
            thumb.Size             = UDim2.fromOffset(12, 12)
            thumb.AnchorPoint      = Vector2.new(0.5, 0.5)
            thumb.Position         = UDim2.new(startPct, 0, 0.5, 0)
            thumb.BackgroundColor3 = Theme.Text
            thumb.BorderSizePixel  = 0
            corner(thumb, 6)

            local currentVal = defaultVal
            local sliding    = false

            local function updateSlider(inputX)
                local rel = math.clamp(
                    (inputX - track.AbsolutePosition.X) / track.AbsoluteSize.X,
                    0, 1
                )
                local val = math.floor(cfg.Min + (cfg.Max - cfg.Min) * rel)
                currentVal = val
                fill.Size  = UDim2.new(rel, 0, 1, 0)
                thumb.Position = UDim2.new(rel, 0, 0.5, 0)
                valLbl.Text    = tostring(val) .. (cfg.Suffix or "")
                setConfig(cfg.Flag, val)
                if autoSaveEnabled then saveConfig() end
                if cfg.Callback then cfg.Callback(val) end
            end

            -- Clickable area
            local btn = Instance.new("TextButton", row)
            btn.Size                  = UDim2.new(1, 0, 1, 0)
            btn.BackgroundTransparency = 1
            btn.Text                  = ""
            btn.ZIndex                = 2

            btn.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = true
                    updateSlider(input.Position.X)
                end
            end)
            btn.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = false
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if sliding and (
                    input.UserInputType == Enum.UserInputType.MouseMovement
                    or input.UserInputType == Enum.UserInputType.Touch
                ) then
                    updateSlider(input.Position.X)
                end
            end)

            -- Apply default
            if cfg.Callback then
                task.defer(function()
                    cfg.Callback(defaultVal)
                end)
            end

            return {
                SetValue = function(v)
                    local rel = math.clamp(
                        (v - cfg.Min) / (cfg.Max - cfg.Min), 0, 1
                    )
                    currentVal = v
                    fill.Size  = UDim2.new(rel, 0, 1, 0)
                    thumb.Position = UDim2.new(rel, 0, 0.5, 0)
                    valLbl.Text = tostring(v) .. (cfg.Suffix or "")
                end,
                GetValue = function() return currentVal end,
            }
        end

        -- BUTTON
        function Section:AddButton(cfg)
            -- cfg: { Name, Callback }
            local btn = Instance.new("TextButton", itemContainer)
            btn.Size             = UDim2.new(1, 0, 0, 30)
            btn.BackgroundColor3 = Theme.AccentDark
            btn.Text             = cfg.Name
            btn.TextColor3       = Theme.Text
            btn.TextSize         = 13
            btn.Font             = Theme.Font
            btn.BorderSizePixel  = 0
            btn.AutoButtonColor  = false
            corner(btn, 5)

            btn.MouseEnter:Connect(function()
                tween(btn, { BackgroundColor3 = Theme.Accent }, 0.1)
            end)
            btn.MouseLeave:Connect(function()
                tween(btn, { BackgroundColor3 = Theme.AccentDark }, 0.1)
            end)
            btn.MouseButton1Click:Connect(function()
                tween(btn, { BackgroundColor3 = Theme.AccentHover }, 0.05)
                task.delay(0.1, function()
                    tween(btn, { BackgroundColor3 = Theme.AccentDark }, 0.1)
                end)
                if cfg.Callback then cfg.Callback() end
            end)
        end

        -- DROPDOWN
        function Section:AddDropdown(cfg)
            -- cfg: { Name, Flag, Items, Default, Callback }
            local defaultVal = getConfig(cfg.Flag, cfg.Default or cfg.Items[1])

            local row = Instance.new("Frame", itemContainer)
            row.Size             = UDim2.new(1, 0, 0, 56)
            row.BackgroundColor3 = Theme.Bg
            row.BorderSizePixel  = 0
            corner(row, 5)
            row.ClipsDescendants = false

            makeLabel(
                row, cfg.Name,
                UDim2.new(1, -10, 0, 20),
                Theme.Text, Theme.FontSm
            ).Position = UDim2.new(0, 10, 0, 4)

            local trigger = Instance.new("TextButton", row)
            trigger.Size             = UDim2.new(1, -20, 0, 26)
            trigger.Position         = UDim2.new(0, 10, 0, 26)
            trigger.BackgroundColor3 = Theme.Section
            trigger.Text             = "  " .. tostring(defaultVal)
            trigger.TextColor3       = Theme.Text
            trigger.TextSize         = 12
            trigger.Font             = Theme.FontSm
            trigger.TextXAlignment   = Enum.TextXAlignment.Left
            trigger.BorderSizePixel  = 0
            trigger.AutoButtonColor  = false
            corner(trigger, 4)
            stroke(trigger, Theme.Border, 1)

            local arrow = makeLabel(
                trigger, "▾",
                UDim2.new(0, 20, 1, 0),
                Theme.Accent, Theme.Font,
                Enum.TextXAlignment.Center
            )
            arrow.Position = UDim2.new(1, -22, 0, 0)

            local open        = false
            local dropFrame   = nil
            local currentVal  = defaultVal

            trigger.MouseButton1Click:Connect(function()
                open = not open
                if dropFrame then
                    pcall(function() dropFrame:Destroy() end)
                    dropFrame = nil
                end
                if not open then return end

                dropFrame = Instance.new("Frame", ScreenGui)
                dropFrame.Size             = UDim2.fromOffset(
                    trigger.AbsoluteSize.X, #cfg.Items * 26 + 6
                )
                dropFrame.Position         = UDim2.fromOffset(
                    trigger.AbsolutePosition.X,
                    trigger.AbsolutePosition.Y + trigger.AbsoluteSize.Y + 2
                )
                dropFrame.BackgroundColor3 = Theme.Section
                dropFrame.BorderSizePixel  = 0
                dropFrame.ZIndex           = 10
                corner(dropFrame, 5)
                stroke(dropFrame, Theme.Border, 1)

                local dLayout = Instance.new("UIListLayout", dropFrame)
                dLayout.Padding = UDim.new(0, 2)
                dLayout.SortOrder = Enum.SortOrder.LayoutOrder

                local dPad = Instance.new("UIPadding", dropFrame)
                dPad.PaddingTop    = UDim.new(0, 3)
                dPad.PaddingBottom = UDim.new(0, 3)
                dPad.PaddingLeft   = UDim.new(0, 4)
                dPad.PaddingRight  = UDim.new(0, 4)

                for _, item in ipairs(cfg.Items) do
                    local itemBtn = Instance.new("TextButton", dropFrame)
                    itemBtn.Size             = UDim2.new(1, 0, 0, 24)
                    itemBtn.BackgroundColor3 = item == currentVal
                        and Theme.AccentDark or Theme.Section
                    itemBtn.Text             = "  " .. tostring(item)
                    itemBtn.TextColor3       = item == currentVal
                        and Theme.Text or Theme.TextDim
                    itemBtn.TextSize         = 12
                    itemBtn.Font             = Theme.FontSm
                    itemBtn.TextXAlignment   = Enum.TextXAlignment.Left
                    itemBtn.BorderSizePixel  = 0
                    itemBtn.AutoButtonColor  = false
                    itemBtn.ZIndex           = 11
                    corner(itemBtn, 4)

                    itemBtn.MouseEnter:Connect(function()
                        if item ~= currentVal then
                            itemBtn.BackgroundColor3 = Theme.Panel
                        end
                    end)
                    itemBtn.MouseLeave:Connect(function()
                        if item ~= currentVal then
                            itemBtn.BackgroundColor3 = Theme.Section
                        end
                    end)

                    itemBtn.MouseButton1Click:Connect(function()
                        currentVal     = item
                        trigger.Text   = "  " .. tostring(item)
                        open = false
                        pcall(function() dropFrame:Destroy() end)
                        dropFrame = nil
                        setConfig(cfg.Flag, item)
                        if autoSaveEnabled then saveConfig() end
                        if cfg.Callback then cfg.Callback(item) end
                    end)
                end

                -- Close on outside click
                local closeConn
                closeConn = UserInputService.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        task.defer(function()
                            if dropFrame and dropFrame.Parent then
                                pcall(function() dropFrame:Destroy() end)
                                dropFrame = nil
                            end
                            open = false
                            closeConn:Disconnect()
                        end)
                    end
                end)
            end)

            return {
                SetValue = function(v)
                    currentVal   = v
                    trigger.Text = "  " .. tostring(v)
                end,
                GetValue = function() return currentVal end,
            }
        end

        -- INPUT
        function Section:AddInput(cfg)
            -- cfg: { Name, Flag, Default, Placeholder, Callback }
            local defaultVal = getConfig(cfg.Flag, cfg.Default or "")

            local row = Instance.new("Frame", itemContainer)
            row.Size             = UDim2.new(1, 0, 0, 56)
            row.BackgroundColor3 = Theme.Bg
            row.BorderSizePixel  = 0
            corner(row, 5)

            makeLabel(
                row, cfg.Name,
                UDim2.new(1, -10, 0, 20),
                Theme.Text, Theme.FontSm
            ).Position = UDim2.new(0, 10, 0, 4)

            local box = Instance.new("TextBox", row)
            box.Size                = UDim2.new(1, -20, 0, 26)
            box.Position            = UDim2.new(0, 10, 0, 26)
            box.BackgroundColor3    = Theme.Section
            box.Text                = tostring(defaultVal)
            box.PlaceholderText     = cfg.Placeholder or ""
            box.TextColor3          = Theme.Text
            box.PlaceholderColor3   = Theme.TextDim
            box.TextSize            = 12
            box.Font                = Theme.FontSm
            box.BorderSizePixel     = 0
            box.ClearTextOnFocus    = false
            corner(box, 4)
            stroke(box, Theme.Border, 1)

            box.FocusLost:Connect(function(enter)
                setConfig(cfg.Flag, box.Text)
                if autoSaveEnabled then saveConfig() end
                if cfg.Callback then cfg.Callback(box.Text) end
            end)

            return box
        end

        -- LABEL
        function Section:AddLabel(text)
            makeLabel(
                itemContainer, text,
                UDim2.new(1, -10, 0, 18),
                Theme.TextDim, Theme.FontSm
            ).Position = UDim2.new(0, 5, 0, 0)
        end

        return Section
    end

    return {
        CreateSection = createSection,
        Page          = page,
    }
end

