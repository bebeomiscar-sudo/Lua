local VoidLeft  = Tabs.VoidSpam:AddLeftGroupbox("🌀 Void Spam")
local VoidRight = Tabs.VoidSpam:AddRightGroupbox("⚙️ Void Settings")

local hrp_vs        = nil
local clientC_vs    = nil
local clientV_vs    = nil
local clientVA_vs   = nil
local voidActive    = false
local voidHBConn    = nil
local voidRSConn    = nil

-- Void intensity slider
local VoidIntensity = 2147483646
local VoidMinExclude = 1147483646

VoidRight:AddSlider("VoidIntensity", {
    Text    = "Void Intensity",
    Default = 100,
    Min     = 1,
    Max     = 100,
    Rounding = 0,
    Tooltip  = "How extreme the void teleports are (100 = max chaos)",
    Callback = function(val)
        local scale = val / 100
        VoidIntensity    = math.floor(2147483646 * scale)
        VoidMinExclude   = math.floor(1147483646 * scale)
    end,
})

local function betterRandom(mi, ma, dmi, dma)
    local val = math.random(mi, ma)
    local attempts = 0
    repeat
        val = math.random(mi, ma)
        attempts = attempts + 1
    until val < dmi or val > dma or attempts > 20
    return val
end

local function startVoidSpam()
    voidActive = true

    voidHBConn = RunService.Heartbeat:Connect(function()
        pcall(function()
            hrp_vs  = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
            if not hrp_vs then return end
            clientC_vs  = hrp_vs.CFrame
            clientV_vs  = hrp_vs.AssemblyLinearVelocity
            clientVA_vs = hrp_vs.AssemblyAngularVelocity

            local ri = VoidIntensity
            local re = VoidMinExclude

            hrp_vs.CFrame = CFrame.new(
                betterRandom(-ri, ri, -re, re),
                betterRandom(-ri, ri, -re, re),
                betterRandom(-ri, ri, -re, re)
            ) * CFrame.Angles(
                math.rad(math.pi),
                math.rad(math.pi),
                math.rad(math.pi)
            )
            hrp_vs.AssemblyLinearVelocity = Vector3.new(
                betterRandom(-ri, ri, -re, re),
                betterRandom(-ri, ri, -re, re),
                betterRandom(-ri, ri, -re, re)
            )
            hrp_vs.AssemblyAngularVelocity = Vector3.new(
                betterRandom(-ri, ri, -re, re),
                betterRandom(-ri, ri, -re, re),
                betterRandom(-ri, ri, -re, re)
            )
        end)
    end)

    RunService:BindToRenderStep("VoidSync", Enum.RenderPriority.First.Value, function()
        if hrp_vs and clientC_vs then
            pcall(function()
                hrp_vs.CFrame                  = clientC_vs
                hrp_vs.AssemblyLinearVelocity  = clientV_vs
                hrp_vs.AssemblyAngularVelocity = clientVA_vs
            end)
        end
    end)
end

local function stopVoidSpam()
    voidActive = false
    if voidHBConn then
        voidHBConn:Disconnect()
        voidHBConn = nil
    end
    pcall(function()
        RunService:UnbindFromRenderStep("VoidSync")
    end)
    hrp_vs = nil
end

