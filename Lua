local voidConn = nil

local function initPhase()
    Config.void.phase      = "shoot"
    Config.void.currentDur = Config.void.shootMin
        + math.random() * math.max(Config.void.shootMax - Config.void.shootMin, 0)
    Config.void.lastSwitch = tick()
end

local function tickPhase()
    if not Config.void.enabled then return end
    local now     = tick()
    local elapsed = now - Config.void.lastSwitch

    if Config.void.phase == "shoot" then
        if elapsed >= Config.void.currentDur then
            Config.void.phase      = "hide"
            Config.void.currentDur = Config.void.hideMin
                + math.random() * math.max(Config.void.hideMax - Config.void.hideMin, 0)
            Config.void.lastSwitch = now
        end
    elseif Config.void.phase == "hide" then
        if elapsed >= Config.void.currentDur then
            Config.void.phase      = "shoot"
            Config.void.currentDur = Config.void.shootMin
                + math.random() * math.max(Config.void.shootMax - Config.void.shootMin, 0)
            Config.void.lastSwitch = now
        end
    end
end

local function autoFindTarget()
    if not Config.void.autoTarget then return end
    if Config.target.character then
        local hum = Config.target.character:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 and Config.target.character.Parent then return end
        Config.target.character = nil
        Config.target.player    = nil
        Config.target.enabled   = false
    end

    local best, bestD = nil, math.huge
    local cur = UserInputService:GetMouseLocation()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        local char = plr.Character
        if not char then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end
        local sp, onScreen = Camera:WorldToViewportPoint(hrp.Position)
        if onScreen then
            local d = (Vector2.new(sp.X, sp.Y) - cur).Magnitude
            if d < bestD and d <= Config.void.fovSize then
                best  = char
                bestD = d
            end
        end
    end

    if best then
        Config.target.character = best
        Config.target.player    = Players:GetPlayerFromCharacter(best)
        Config.target.enabled   = true
    end
end

local function startVoidSpam()
    if voidConn then return end
    startSlingshotTouch()
    initPhase()

    voidConn = RunService.Heartbeat:Connect(function()
        if not Config.void.enabled then
            voidConn:Disconnect()
            voidConn = nil
            stopSlingshotTouch()
            restoreFromVoid()
            return
        end

        tickPhase()
        autoFindTarget()

        -- Validate target
        if Config.target.character then
            local hum = Config.target.character:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 or not Config.target.character.Parent then
                Config.target.character = nil
                Config.target.player    = nil
                Config.target.enabled   = false
                clearSnap()
                return
            end
        end

        if Config.void.phase == "shoot" then
            -- Restore from void first
            if vfrSnap.cf then restoreFromVoid() end

            -- Equip correct weapon
            if Config.weapon.forceEquip then
                if not isModeEquipped(Config.weapon.mode) then
                    forceEquipWeapon(Config.weapon.mode)
                end
            end

            -- Lower riot if smart riot is blocking
            if Config.smartRiot.enabled and Config.smartRiot.blockOnVoid then
                lowerRiotShield()
            end

            -- Fire based on weapon mode
            if Config.target.character then
                local mode = Config.weapon.mode
                if mode == "Slingshot" then
                    fireSlingshot()
                elseif mode == "Knife" then
                    fireKnife()
                elseif mode == "Melee" then
                    fireMelee()
                else
                    -- Primary / Secondary: use UseItem StartShooting
                    local item = findItemBySlot(WEAPON_SLOT_MAP[mode] or 1)
                    if item then
                        local oid     = getItemOID(item)
                        local hitPart = getHitPart(Config.target.character, Config.void.hitpart)
                        if oid and hitPart then
                            local origin    = getShootOrigin()
                            local targetPos = predictPos(hitPart, origin)
                            local data      = buildShootData(origin, targetPos, hitPart)
                            pcall(function()
                                UseItemRemote:FireServer(
                                    oid,
                                    Modules.Enums:ToEnum("StartShooting"),
                                    data,
                                    nil
                                )
                            end)
                        end
                    end
                end
            end

        elseif Config.void.phase == "hide" then
            -- Enter void
            if not vfrSnap.cf then
                snapToVoid()
            end

            -- Smart riot: raise shield while hiding
            if Config.smartRiot.enabled and Config.smartRiot.blockOnVoid then
                if Config.smartRiot.autoEquip then
                    equipRiotShield()
                end
                fireRiotBlock()
            end
        end

        -- Prediction velocity
        if Config.prediction.enabled and Config.target.character then
            updateVelocity()
        end
    end)
end

local function stopVoidSpam()
    Config.void.enabled = false
    Config.void.phase   = nil
    if voidConn then
        voidConn:Disconnect()
        voidConn = nil
    end
    stopSlingshotTouch()
    restoreFromVoid()
    clearSnap()
end

