RunService.RenderStepped:Connect(function()
    local center    = Camera.ViewportSize / 2
    local hasTarget = Config.target.enabled
        and Config.target.character
        and Config.target.character.Parent ~= nil

    --// FOV Circle
    local showFov = Config.visuals.fovCircle and Config.void.enabled
    fovCircle.Visible  = showFov
    fovOutline.Visible = showFov
    if showFov then
        fovCircle.Position  = center
        fovCircle.Radius    = Config.void.fovSize
        fovCircle.Color     = Config.visuals.fovColor
        fovOutline.Position = center
        fovOutline.Radius   = Config.void.fovSize
    end

    --// Target dot + tracer
    if hasTarget and Config.visuals.indicator then
        local hitPart = getHitPart(Config.target.character, Config.void.hitpart)
        if hitPart then
            local sp, onScreen = Camera:WorldToViewportPoint(hitPart.Position)
            if onScreen then
                local sv = Vector2.new(sp.X, sp.Y)
                tDot.Position    = sv
                tDotOut.Position = sv
                tDot.Color       = Config.void.phase == "hide"
                    and Color3.fromRGB(255, 165, 0)
                    or  Config.visuals.espColor
                tDot.Visible    = true
                tDotOut.Visible = true

                if Config.visuals.tracer then
                    local from = Vector2.new(center.X, Camera.ViewportSize.Y)
                    tracer.From     = from ; tracer.To     = sv
                    tracerOut.From  = from ; tracerOut.To  = sv
                    tracer.Color    = Config.visuals.tracerColor
                    tracer.Visible      = true
                    tracerOut.Visible   = true
                else
                    tracer.Visible    = false
                    tracerOut.Visible = false
                end
            else
                tDot.Visible = false ; tDotOut.Visible = false
                tracer.Visible = false ; tracerOut.Visible = false
            end
        end
    else
        tDot.Visible = false ; tDotOut.Visible = false
        tracer.Visible = false ; tracerOut.Visible = false
    end

    --// ESP
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        local e = ESPObjects[plr]
        if not e then continue end
        local char = plr.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        local head = char and (char:FindFirstChild("Head"))

        if not Config.visuals.esp or not hrp or not hum or not head then
            for k, d in pairs(e) do
                if typeof(d) ~= "number" then pcall(function() d.Visible = false end) end
            end
            continue
        end

        local myHRP   = getHRP()
        local rootSP, vis = Camera:WorldToViewportPoint(hrp.Position)
        local headSP      = Camera:WorldToViewportPoint(head.Position + Vector3.new(0,0.5,0))

        if not vis then
            for k, d in pairs(e) do
                if typeof(d) ~= "number" then pcall(function() d.Visible = false end) end
            end
            continue
        end

        local dist  = myHRP and math.floor((hrp.Position - myHRP.Position).Magnitude) or 0
        local hDiff = math.abs(rootSP.Y - headSP.Y)
        local w     = hDiff * 0.6
        local bx    = rootSP.X - w / 2
        local by    = headSP.Y
        local bh    = hDiff * 1.1
        local col   = (Config.target.character == char)
            and Color3.fromRGB(255, 165, 0)
            or  Config.visuals.espColor

        e.box.Size      = Vector2.new(w, bh) ; e.box.Position    = Vector2.new(bx, by) ; e.box.Color   = col ; e.box.Visible = true
        e.boxOut.Size   = Vector2.new(w, bh) ; e.boxOut.Position = Vector2.new(bx, by) ; e.boxOut.Visible = true
        e.name.Text     = plr.DisplayName    ; e.name.Position   = Vector2.new(rootSP.X, by - 15) ; e.name.Color = col ; e.name.Visible = true
        e.dist.Text     = dist.."m"          ; e.dist.Position   = Vector2.new(rootSP.X, by + bh + 2) ; e.dist.Visible = true

        local hp   = hum.Health / math.max(hum.MaxHealth, 1)
        local barW = 4
        local barX = bx - 7
        e.hpBg.Size     = Vector2.new(barW, bh)       ; e.hpBg.Position   = Vector2.new(barX, by)              ; e.hpBg.Visible   = true
        e.hpFill.Size   = Vector2.new(barW, bh * hp)  ; e.hpFill.Position = Vector2.new(barX, by+bh - bh*hp)   ; e.hpFill.Visible = true
        e.hpFill.Color  = Color3.fromRGB(255*(1-hp), 255*hp, 0)

        -- Hit detect
        local prevHP = e._lastHP or hum.Health
        if hum.Health < prevHP then
            local dmg = math.floor(prevHP - hum.Health)
            if dmg > 0 then
                pushNotif(string.format("💥 %s  -%d hp  (%.0f left)", plr.Name, dmg, hum.Health))
            end
        end
        e._lastHP = hum.Health
    end

    --// Status HUD
    if Config.visuals.statusHUD then
        local anchor = center + Vector2.new(0, 40)
        local phase  = Config.void.phase or "off"
        local targetNm = Config.target.player and Config.target.player.Name or "none"
        local riotState = Config.riotGodmode.enabled and " | 🛡️GODMODE"
            or Config.smartRiot.enabled and " | 🛡️smart"
            or ""

        local mainStr = "voidspam: " .. phase .. riotState
        hudLine1.Text     = mainStr
        hudLine1.Color    = phase == "hide"
            and Color3.fromRGB(255, 165, 0)
            or  Config.visuals.statusColor
        hudLine1.Position = anchor
        hudLine1.Visible  = Config.void.enabled

        hudLine2.Text     = "target: " .. targetNm
        hudLine2.Position = anchor + Vector2.new(0, 16)
        hudLine2.Visible  = Config.void.enabled

        -- Phase indicator (top center)
        if Config.void.enabled then
            phaseLabel.Text     = phase == "hide" and "[ HIDING ]" or "[ SHOOTING ]"
            phaseLabel.Color    = phase == "hide"
                and Color3.fromRGB(255, 165, 0)
                or  Color3.fromRGB(0, 255, 100)
            phaseLabel.Position = Vector2.new(center.X, 30)
            phaseLabel.Visible  = true
        else
            phaseLabel.Visible  = false
        end
    else
        hudLine1.Visible  = false
        hudLine2.Visible  = false
        phaseLabel.Visible = false
    end

    --// Hit notifications
    local now     = tick()
    local toRemove = {}
    for i, entry in ipairs(HitNotifs) do
        local elapsed = now - entry.t
        local alpha   = 1 - math.clamp((elapsed - (entry.dur - 0.5)) / 0.5, 0, 1)
        entry.lbl.Transparency = alpha
        entry.lbl.Position     = Vector2.new(12, 12 + (i - 1) * 18)
        if elapsed >= entry.dur then
            table.insert(toRemove, i)
        end
    end
    for i = #toRemove, 1, -1 do
        local idx = toRemove[i]
        pcall(function() HitNotifs[idx].lbl:Remove() end)
        table.remove(HitNotifs, idx)
    end
end)

