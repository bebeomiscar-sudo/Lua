local function applyMolotovColor(color)
    pcall(function()
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("ParticleEmitter") or obj:IsA("Fire") then
                local parent = obj.Parent
                if parent and (
                    parent.Name:lower():find("molotov") or
                    parent.Name:lower():find("fire") or
                    parent.Name:lower():find("flame") or
                    parent.Name:lower():find("explosion")
                ) then
                    pcall(function()
                        if obj:IsA("Fire") then
                            obj.Color     = color
                            obj.SecondaryColor = color
                        elseif obj:IsA("ParticleEmitter") then
                            obj.Color = ColorSequence.new(color)
                        end
                    end)
                end
            end
        end
    end)
end

