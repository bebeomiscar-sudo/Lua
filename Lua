--// ═══════════════════════════════════════════════════════════

local function getRiotItem()
    return findItemByName("Riot") or findItemByName("Shield")
end

local function getRiotOID()
    local item = getRiotItem()
    return item and getItemOID(item) or nil
end

local lastRiotFire = 0

--// Fire riot shield UseItem to block projectiles
local function fireRiotBlock()
    local oid = getRiotOID()
    if not oid then return end

    local now = tick()
    if now - lastRiotFire < Config.riotGodmode.spamRate then return end
    lastRiotFire = now

    -- Raise shield (StartBlocking / Block enum)
    for _, enumName in ipairs({"StartBlocking","Block","Shield","Defend","RaiseShield","Use","StartUsing"}) do
        pcall(function()
            local ev = Modules.Enums:ToEnum(enumName)
            if ev then
                UseItemRemote:FireServer(oid, ev, nil, nil)
            end
        end)
    end

    -- Also try RiotShield module methods
    pcall(function()
        if Modules.RiotShield then
            if Modules.RiotShield.StartBlock then Modules.RiotShield:StartBlock() end
            if Modules.RiotShield.Block      then Modules.RiotShield:Block()      end
            if Modules.RiotShield.Raise      then Modules.RiotShield:Raise()      end
        end
    end)
end

local function equipRiot()
    local riotItem = getRiotItem()
    if not riotItem then return false end
    local oid = getItemOID(riotItem)
    if not oid then return false end

    for _, enumName in ipairs({"Equip","Switch","EquipItem","Select"}) do
        pcall(function()
            local ev = Modules.Enums:ToEnum(enumName)
            if ev then UseItemRemote:FireServer(oid, ev, nil, nil) end
        end)
    end

    local lf = getLocalFighter()
    pcall(function()
        if lf and lf.EquipItem then lf:EquipItem(2) end
    end)
    pressSlot(2)
    return true
end

local function lowerRiot()
    local oid = getRiotOID()
    if not oid then return end
    for _, enumName in ipairs({"StopBlocking","Unblock","LowerShield","StopUsing","Stop"}) do
        pcall(function()
            local ev = Modules.Enums:ToEnum(enumName)
            if ev then UseItemRemote:FireServer(oid, ev, nil, nil) end
        end)
    end
end

