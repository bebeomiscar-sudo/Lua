--//                  SLINGSHOT FIRE
--// ═══════════════════════════════════════════════════════════

local lastSlingFire = 0

local function fireSlingshot()
    if Config.void.phase == "hide" then return end
    if not Config.target.character then return end

    local item = findItemByKeyword("slingshot") or getEquipped()
    if not item then return end

    local oid = getItemOID(item)
    if not oid then return end

    local char    = Config.target.character
    local hum     = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end

    local hitPart = getHitPart(char, Config.void.hitpart)
    if not hitPart then return end

    local origin    = getShootOrigin()
    local targetPos = predictPos(hitPart, origin)
    local data      = buildShootData(origin, targetPos, hitPart)

    local attempts = math.clamp(Config.void.attempts, 1, 3)
    for _ = 1, attempts do
        pcall(function()
            UseItemRemote:FireServer(
                oid,
                Modules.Enums:ToEnum("StartShooting"),
                data,
                nil
            )
        end)
    end
    lastSlingFire = tick()
end

--// ═══════════════════════════════════════════════════════════
--//                  KNIFE FIRE (Melee UseItem)
--// ═══════════════════════════════════════════════════════════

local lastKnifeFire  = 0
local KNIFE_COOLDOWN = 0.35

local function fireKnife()
    if not Config.weapon.knifeEnabled then return end
    if not Config.target.character then return end

    local now = tick()
    if now - lastKnifeFire < KNIFE_COOLDOWN then return end

    local item = findItemByKeyword("knife") or findItemBySlot(3)
    if not item then return end

    local oid = getItemOID(item)
    if not oid then return end

    local char    = Config.target.character
    local hum     = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end

    local hitPart = getHitPart(char, Config.weapon.knifePart)
    if not hitPart then return end

    local origin    = getShootOrigin()
    local targetPos = predictPos(hitPart, origin)
    local data      = buildShootData(origin, targetPos, hitPart)

    local attempts = math.clamp(Config.weapon.knifeAttempts, 1, 3)
    for _ = 1, attempts do
        -- Melee: use Attack / Strike enum
        for _, enumName in ipairs({"Attack","Strike","Swing","Hit","Use","MeleeAttack","StartAttacking"}) do
            pcall(function()
                local ev = Modules.Enums:ToEnum(enumName)
                if ev then
                    UseItemRemote:FireServer(oid, ev, data, nil)
                end
            end)
        end
        -- Also try MeleeType module methods
        pcall(function()
            if Modules.MeleeType then
                local lf = getLF()
                if lf and lf.Attack   then lf:Attack(hitPart)   end
                if lf and lf.MeleeHit then lf:MeleeHit(hitPart) end
            end
        end)
    end

    lastKnifeFire = now
end

