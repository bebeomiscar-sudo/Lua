--// Weapon slot mapping
local WEAPON_SLOT_MAP = {
    ["Primary"]   = 1,
    ["Secondary"] = 2,
    ["Melee"]     = 3,
    ["Slingshot"] = 1,   -- Slingshot is primary slot
    ["Knife"]     = 3,   -- Knife is melee slot
}

--// Weapon keyword map for findItemByKeyword
local WEAPON_KEYWORD_MAP = {
    ["Primary"]   = nil,          -- just use slot 1
    ["Secondary"] = nil,          -- just use slot 2
    ["Melee"]     = "melee",
    ["Slingshot"] = "slingshot",
    ["Knife"]     = "knife",
}

local SLOT_KEYS = { Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three }
local SLOT_HEX  = { 0x31, 0x32, 0x33 }
local lastSlotPress = 0

local function pressSlot(idx)
    if not idx or idx < 1 or idx > 3 then return end
    local now = tick()
    if now - lastSlotPress < 0.05 then return end
    lastSlotPress = now
    pcall(function()
        VirtualInput:SendKeyEvent(true,  SLOT_KEYS[idx], false, game)
        task.wait(0.02)
        VirtualInput:SendKeyEvent(false, SLOT_KEYS[idx], false, game)
    end)
    if keypress then
        pcall(keypress,   SLOT_HEX[idx])
        task.wait(0.02)
        if keyrelease then pcall(keyrelease, SLOT_HEX[idx]) end
    end
end

local function equipByOID(oid)
    if not oid then return end
    for _, enumName in ipairs({"Equip","Switch","Select","EquipItem","ChangeItem"}) do
        pcall(function()
            local ev = Modules.Enums:ToEnum(enumName)
            if ev then UseItemRemote:FireServer(oid, ev, nil, nil) end
        end)
    end
end

local lastForceEquip = 0

local function forceEquipWeapon(mode)
    local now = tick()
    if now - lastForceEquip < 0.06 then return end
    lastForceEquip = now

    local lf = getLF()
    if not lf then return end

    local slotIdx = WEAPON_SLOT_MAP[mode] or 1
    local keyword = WEAPON_KEYWORD_MAP[mode]

    local item = keyword and findItemByKeyword(keyword) or findItemBySlot(slotIdx)
    if not item then return end

    local oid = getItemOID(item)
    if not oid then return end

    -- Check if already equipped
    local eq = getEquipped()
    if eq and getItemOID(eq) == oid then return end

    -- Fire UseItem equip
    equipByOID(oid)

    -- Also try local fighter methods
    pcall(function()
        if lf.EquipItem     then lf:EquipItem(slotIdx)     end
        if lf.SwitchToSlot  then lf:SwitchToSlot(slotIdx)  end
        if lf.Equip         then lf:Equip(slotIdx)         end
    end)

    pressSlot(slotIdx)
end

local function getCurrentWeaponName()
    local eq = getEquipped()
    return eq and getItemName(eq) or "none"
end

local function isModeEquipped(mode)
    local nm = getCurrentWeaponName():lower()
    local keyword = WEAPON_KEYWORD_MAP[mode]
    if keyword then
        return nm:find(keyword, 1, true) ~= nil
    end
    -- For Primary/Secondary check slot
    local slotIdx = WEAPON_SLOT_MAP[mode]
    if slotIdx then
        local slotItem = findItemBySlot(slotIdx)
        return slotItem and getItemOID(slotItem) == getItemOID(getEquipped())
    end
    return false
end

--// ═══════════════════════════════════════════════════════════
--//                  SLINGSHOT TOUCH HOOK
--// ═══════════════════════════════════════════════════════════

local slingshotConn = nil

local function getTargetHead()
    if Config.target.character then
        local char = Config.target.character
        local hum  = char:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then
            return char:FindFirstChild("HitboxHead") or char:FindFirstChild("Head")
        end
    end
    -- Fallback: nearest head
    local hrp = getHRP()
    if not hrp then return nil end
    local best, bestD = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        local char = plr.Character
        if not char then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        local head = char:FindFirstChild("HitboxHead") or char:FindFirstChild("Head")
        if not head then continue end
        local d = (head.Position - hrp.Position).Magnitude
        if d < bestD then best = head bestD = d end
    end
    return best
end

local function startSlingshotTouch()
    if slingshotConn then return end
    slingshotConn = workspace.DescendantAdded:Connect(function(obj)
        local valid = (
            obj.Name == "Slingshot"      or
            obj.Name == "CoreProjectile" or
            obj.Name == "OuterProjectile"
        )
        if not valid then return end
        if not (obj:IsA("BasePart") or obj:IsA("Model")) then return end

        task.spawn(function()
            task.wait(0.05)
            local part = obj:IsA("BasePart") and obj
                or obj:FindFirstChildWhichIsA("BasePart")
            if not part then return end
            pcall(function() part.CanTouch = true end)

            for _ = 1, 180 do
                if not part.Parent or not part:IsDescendantOf(workspace) then break end
                local head = getTargetHead()
                if head and head:IsA("BasePart") and head.Parent and head:IsDescendantOf(workspace) then
                    pcall(firetouchinterest, head, part, 0)
                    pcall(firetouchinterest, head, part, 1)
                end
                task.wait()
            end
        end)
    end)
end

local function stopSlingshotTouch()
    if slingshotConn then
        slingshotConn:Disconnect()
        slingshotConn = nil
    end
end

