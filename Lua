        local Sec = {}

        -- TOGGLE
        function Sec:Toggle(cfg)
            local defVal = getConfig(cfg.Flag, cfg.Default or false)
            local row = Instance.new("Frame", items)
            row.Size             = UDim2.new(1,0,0,30)
            row.BackgroundColor3 = Theme.Item
            row.BorderSizePixel  = 0
            mkCorner(row, 5)

            local lbl = mkLabel(row, cfg.Name,
                UDim2.new(1,-50,1,0), Theme.Text, Theme.FontSm)
            lbl.Position = UDim2.new(0,10,0,0)

            local pill = Instance.new("Frame", row)
            pill.Size             = UDim2.fromOffset(36,18)
            pill.Position         = UDim2.new(1,-44,0.5,-9)
            pill.BackgroundColor3 = defVal and Theme.ToggleON or Theme.ToggleOFF
            pill.BorderSizePixel  = 0
            mkCorner(pill, 9)

            local knob = Instance.new("Frame", pill)
            knob.Size             = UDim2.fromOffset(12,12)
            knob.Position         = defVal
                and UDim2.new(1,-15,0.5,-6)
                or  UDim2.new(0,3,0.5,-6)
            knob.BackgroundColor3 = Theme.Text
            knob.BorderSizePixel  = 0
            mkCorner(knob, 6)

            local enabled = defVal

            local function apply(v)
                enabled = v
                tw(pill, { BackgroundColor3 = v and Theme.ToggleON or Theme.ToggleOFF }, 0.15)
                tw(knob, {
                    Position = v
                        and UDim2.new(1,-15,0.5,-6)
                        or  UDim2.new(0,3,0.5,-6)
                }, 0.15)
                setConfig(cfg.Flag, v)
                if cfg.Callback then cfg.Callback(v) end
            end

            local hitbox = Instance.new("TextButton", row)
            hitbox.Size                  = UDim2.new(1,0,1,0)
            hitbox.BackgroundTransparency = 1
            hitbox.Text                  = ""
            hitbox.ZIndex                = 2
            hitbox.MouseButton1Click:Connect(function()
                apply(not enabled)
            end)

            if defVal and cfg.Callback then
                task.defer(function() cfg.Callback(defVal) end)
            end

            return { SetValue = apply, GetValue = function() return enabled end }
        end

        -- SLIDER
        function Sec:Slider(cfg)
            local defVal = getConfig(cfg.Flag,
                math.clamp(cfg.Default or cfg.Min, cfg.Min, cfg.Max))
            local row = Instance.new("Frame", items)
            row.Size             = UDim2.new(1,0,0,46)
            row.BackgroundColor3 = Theme.Item
            row.BorderSizePixel  = 0
            mkCorner(row, 5)

            local nLbl = mkLabel(row, cfg.Name,
                UDim2.new(0.6,0,0,20), Theme.Text, Theme.FontSm)
            nLbl.Position = UDim2.new(0,10,0,4)

            local vLbl = mkLabel(row,
                tostring(defVal)..(cfg.Suffix or ""),
                UDim2.new(0.4,-10,0,20),
                Theme.Accent, Theme.Font,
                Enum.TextXAlignment.Right)
            vLbl.Position = UDim2.new(0.6,0,0,4)

            local track = Instance.new("Frame", row)
            track.Size             = UDim2.new(1,-20,0,5)
            track.Position         = UDim2.new(0,10,0,32)
            track.BackgroundColor3 = Theme.SliderBg
            track.BorderSizePixel  = 0
            mkCorner(track, 3)

            local startPct = (defVal - cfg.Min) / (cfg.Max - cfg.Min)
            local fill = Instance.new("Frame", track)
            fill.Size             = UDim2.new(startPct,0,1,0)
            fill.BackgroundColor3 = Theme.SliderFill
            fill.BorderSizePixel  = 0
            mkCorner(fill, 3)

            local thumb = Instance.new("Frame", track)
            thumb.Size             = UDim2.fromOffset(11,11)
            thumb.AnchorPoint      = Vector2.new(0.5,0.5)
            thumb.Position         = UDim2.new(startPct,0,0.5,0)
            thumb.BackgroundColor3 = Theme.Text
            thumb.BorderSizePixel  = 0
            mkCorner(thumb, 6)

            local curVal = defVal
            local sliding = false

            local function upd(ix)
                local rel = math.clamp(
                    (ix - track.AbsolutePosition.X)
                    / track.AbsoluteSize.X, 0, 1)
                local v   = math.floor(cfg.Min + (cfg.Max-cfg.Min)*rel)
                curVal    = v
                fill.Size = UDim2.new(rel,0,1,0)
                thumb.Position = UDim2.new(rel,0,0.5,0)
                vLbl.Text = tostring(v)..(cfg.Suffix or "")
                setConfig(cfg.Flag, v)
                if cfg.Callback then cfg.Callback(v) end
            end

            local hitbox = Instance.new("TextButton", row)
            hitbox.Size                  = UDim2.new(1,0,1,0)
            hitbox.BackgroundTransparency = 1
            hitbox.Text                  = ""
            hitbox.ZIndex                = 2

            hitbox.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = true; upd(input.Position.X)
                end
            end)
            hitbox.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = false
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if sliding and (
                    input.UserInputType == Enum.UserInputType.MouseMovement
                    or input.UserInputType == Enum.UserInputType.Touch
                ) then upd(input.Position.X) end
            end)

            if cfg.Callback then
                task.defer(function() cfg.Callback(defVal) end)
            end

            return {
                SetValue = function(v)
                    local rel = math.clamp((v-cfg.Min)/(cfg.Max-cfg.Min),0,1)
                    curVal = v; fill.Size = UDim2.new(rel,0,1,0)
                    thumb.Position = UDim2.new(rel,0,0.5,0)
                    vLbl.Text = tostring(v)..(cfg.Suffix or "")
