TabWeapons:CreateSection("Tripmine ESP")

local tripESPEnabled  = false
local tripHighlights  = {}
local tripBillboards  = {}
local tripColorESP    = Color3.fromRGB(255, 50, 50)
local tripDetectConn  = nil
local tripNoCDConn    = nil

local function cleanTripESP()
    for _, h in pairs(tripHighlights) do
        pcall(function() h:Destroy() end)
    end
    for _, b in pairs(tripBillboards) do
        pcall(function() b:Destroy() end)
    end
    tripHighlights = {}
    tripBillboards = {}
end

local function isTripmine(obj)
    if not obj then return false end
    local name = obj.Name:lower()
    return name:find("tripmine")
        or name:find("subspace")
        or name:find("mine")
end

local function addTripESP(obj)
    if not obj:IsA("Model") and not obj:IsA("BasePart") then return end
    if not isTripmine(obj) then return end

    local highlight = Instance.new("SelectionBox")
    highlight.Color3              = tripColorESP
    highlight.LineThickness       = 0.05
    highlight.SurfaceTransparency = 0.6
    highlight.SurfaceColor3       = tripColorESP
    highlight.Adornee             = obj
    highlight.Parent              = workspace
    table.insert(tripHighlights, highlight)

    local part = obj:IsA("BasePart") and obj
        or obj:FindFirstChildWhichIsA("BasePart")

    if part then
        local billboard = Instance.new("BillboardGui")
        billboard.AlwaysOnTop = true
        billboard.Size        = UDim2.new(0, 120, 0, 40)
        billboard.StudsOffset = Vector3.new(0, 3, 0)
        billboard.Adornee     = part
        billboard.Parent      = part

        local label = Instance.new("TextLabel")
        label.Size                   = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.TextColor3             = tripColorESP
        label.TextStrokeTransparency = 0
        label.TextScaled             = true
        label.Font                   = Enum.Font.GothamBold
        label.Text                   = "TRIPMINE"
        label.Parent                 = billboard

        local distConn
        distConn = RunService.RenderStepped:Connect(function()
            if not part or not part.Parent then
                distConn:Disconnect()
                pcall(function() billboard:Destroy() end)
                return
            end
            local char = lp.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local dist = math.floor(
                        (hrp.Position - part.Position).Magnitude
                    )
                    label.Text = "TRIPMINE\n" .. dist .. " studs"
                end
            end
        end)

        table.insert(tripBillboards, billboard)
    end

    obj.AncestryChanged:Connect(function()
        if not obj:IsDescendantOf(workspace) then
            pcall(function() highlight:Destroy() end)
        end
    end)
end

local function scanTripmines()
    for _, obj in pairs(workspace:GetDescendants()) do
        if isTripmine(obj) then addTripESP(obj) end
    end
end

