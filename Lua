TabKatana:CreateSection("Katana Fast Deflect")

local katanaLoopActive = false
local katanaLoopThread = nil

local function setFastKatanaDeflect()
    task.wait(0.01)
    for _, v in pairs(getgc(true)) do
        if type(v) == "table" then
            if rawget(v, "DeflectCooldown") then
                rawset(v, "DeflectCooldown", 0.01)
            end
            if rawget(v, "DeflectDuration") then
                rawset(v, "DeflectDuration", 0.01)
            end
        end
    end
    task.wait(0.01)
    pcall(function()
        local Modules = ReplicatedStorage:FindFirstChild("Modules")
        if not Modules then return end
        local lib = Modules:FindFirstChild("ItemLibrary")
        if not lib then return end
        local ItemLibrary = require(lib)
        if ItemLibrary and ItemLibrary.Items then
            for _, item in pairs(ItemLibrary.Items) do
                if item.Name
                    and string.find(item.Name:lower(), "katana") then
                    item.DeflectCooldown = 0.01
                    item.DeflectDuration = 0.01
                end
            end
        end
    end)
    task.wait(0.01)
    pcall(function()
        local MeleeModule = safeRequire(
            lp.PlayerScripts.Modules.ItemTypes.Melee
        )
        if not MeleeModule then return end
        local oldNew = MeleeModule.new
        MeleeModule.new = function(...)
            local self = oldNew(...)
            if self and self.Info and self.Info.Name
                and string.find(self.Info.Name:lower(), "katana") then
                self.Info.DeflectCooldown = 0.01
                self.Info.DeflectDuration = 0.8
            end
            return self
        end
    end)
end

TabKatana:CreateToggle({
    Name         = "Fast Katana Deflect",
    CurrentValue = false,
    Flag         = "KatanaFastDeflect",
    Callback     = function(val)
        katanaLoopActive = val
        if val then
            task.wait(0.5)
            setFastKatanaDeflect()
            katanaLoopThread = task.spawn(function()
                while katanaLoopActive do
                    task.wait(3)
                    if katanaLoopActive then
                        pcall(setFastKatanaDeflect)
                    end
                end
            end)
            notify("Katana", "Fast Deflect Active!")
        else
            if katanaLoopThread then
                pcall(task.cancel, katanaLoopThread)
                katanaLoopThread = nil
            end
            notify("Katana", "Fast Deflect Off")
        end
    end,
})

TabKatana:CreateButton({
    Name     = "Apply Once Now",
