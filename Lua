--// ═══════════════════════════════════════════════════════════

local voidMainConn = nil

local function initPhase()
    Config.void.phase      = "shoot"
    Config.void.currentDur = Config.void.shootMin
        + math.random() * (Config.void.shootMax - Config.void.shootMin)
    Config.void.lastSwitch = tick()
end

local function tickPhase()
    if not Config.void.enabled then return end
    local now     = tick()
    local elapsed = now - Config.void.lastSwitch

    if Config.void.phase == "shoot" then
        if elapsed >= Config.void.currentDur then
            Config.void.phase      = "hide"
            Config.void.currentDur = Config.void.hideMin
                + math.random() * (Config.void.hideMax - Config.void.hideMin)
            Config.void.lastSwitch = now
        end

    elseif Config.void.phase == "hide" then
        if elapsed >= Config.void.currentDur then
            Config.void.phase      = "shoot"
            Config.void.currentDur = Config.void.shootMin
                + math.random() * (Config.void.shootMax - Config.void.shootMin)
            Config.void.lastSwitch = now
        end
    end
end

local function startVoidSpam()
    if voidMainConn then return end

    -- Start slingshot touch hook
    startSlingshotTouch()

    -- Init phase
    initPhase()

    voidMainConn = RunService.Heartbeat:Connect(function()
        if not Config.void.enabled then
            voidMainConn:Disconnect()
            voidMainConn = nil
            stopSlingshotTouch()
            restoreFromVoid()
            return
        end

        tickPhase()

        if not Config.target.character then
            -- Auto target: find nearest
            if Config.void.autoTarget then
                local best, bestD = nil, math.huge
                local cur = UserInputService:GetMouseLocation()
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr == LocalPlayer then continue end
                    local char = plr.Character
                    if not char then continue end
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if not hum or hum.Health <= 0 then continue end
                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    if not hrp then continue end
                    local sp, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                    if onScreen then
                        local d = (Vector2.new(sp.X, sp.Y) - cur).Magnitude
                        if d < bestD and d <= Config.void.fovSize then
                            best  = char
                            bestD = d
                        end
                    end
                end
                if best then
                    Config.target.character = best
                    Config.target.player    = Players:GetPlayerFromCharacter(best)
                    Config.target.enabled   = true
                end
            end
        else
            -- Validate target still alive
            local hum = Config.target.character:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 or not Config.target.character.Parent then
                Config.target.character = nil
                Config.target.player    = nil
                Config.target.enabled   = false
                clearSnap()
                return
            end
        end

        if Config.void.phase == "shoot" then
            -- Restore from void so we are in normal position
            if vfrSnap.cf then
                restoreFromVoid()
            end

            -- Equip slingshot
            if not isSlingEquipped() then
                equipItemBySlot(1)
            end

            -- Fire at target
            if Config.target.character then
                fireSlingshot()

                -- Smart riot: lower shield during shoot phase
                if Config.smartRiot.enabled and Config.smartRiot.blockOnVoid then
                    lowerRiot()
                end
            end

        elseif Config.void.phase == "hide" then
            -- Snap into void
            if not vfrSnap.cf then
                snapToVoid()
            end

            -- Smart riot: raise shield while hiding
            if Config.smartRiot.enabled and Config.smartRiot.blockOnVoid then
                -- Switch to riot shield
                equipRiot()
                fireRiotBlock()
            end
        end

        -- Prediction velocity update
        if Config.prediction.enabled and Config.target.character then
            updateVelocity()
        end
    end)
end

local function stopVoidSpam()
    Config.void.enabled = false
    Config.void.phase   = nil
    if voidMainConn then
        voidMainConn:Disconnect()
        voidMainConn = nil
    end
    stopSlingshotTouch()
    restoreFromVoid()
    clearSnap()
end

