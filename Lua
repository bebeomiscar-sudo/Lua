local function getItemOID(item)
    if not item then return nil end
    local oid = nil
    pcall(function() oid = item:Get("ObjectID") end)
    return oid
end

local function getItemName(item)
    if not item then return "" end
    local nm = ""
    pcall(function() nm = tostring(item:Get("Name") or "") end)
    return nm
end

local function isSlingEquipped()
    local nm = getItemName(getEquipped())
    return nm:lower():find("slingshot", 1, true) ~= nil
end

local function isRiotEquipped()
    local nm = getItemName(getEquipped())
    return nm:lower():find("riot", 1, true) ~= nil
end

local function getItems()
    local lf = getLocalFighter()
    return lf and lf.Items or nil
end

local function findItemByName(keyword)
    local items = getItems()
    if not items then return nil end
    for _, item in pairs(items) do
        if item then
            local nm = getItemName(item)
            if nm:lower():find(keyword:lower(), 1, true) then
                return item
            end
        end
    end
    return nil
end

--// Slot press helper
local SLOT_KEYS = {Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three}
local SLOT_HEX  = {0x31, 0x32, 0x33}

local lastSlotPress = 0

local function pressSlot(idx)
    local now = tick()
    if now - lastSlotPress < 0.05 then return end
    lastSlotPress = now

    pcall(function()
        local kc = SLOT_KEYS[idx]
        if kc then
            VirtualInput:SendKeyEvent(true,  kc, false, game)
            task.wait(0.02)
            VirtualInput:SendKeyEvent(false, kc, false, game)
        end
    end)
    if keypress then
        pcall(keypress,   SLOT_HEX[idx])
        task.wait(0.02)
        if keyrelease then pcall(keyrelease, SLOT_HEX[idx]) end
    end
end

local function equipItemBySlot(slotIdx)
    local lf = getLocalFighter()
    if not lf then return end

    local item = (getItems() or {})[slotIdx]
    local oid  = item and getItemOID(item)

    if oid then
        for _, enumName in ipairs({"Equip","Switch","Select","EquipItem"}) do
            pcall(function()
                local ev = Modules.Enums:ToEnum(enumName)
                if ev then
                    UseItemRemote:FireServer(oid, ev, nil, nil)
                end
            end)
        end
    end

    pcall(function()
        if lf.EquipItem     then lf:EquipItem(slotIdx)  end
        if lf.SwitchToSlot  then lf:SwitchToSlot(slotIdx) end
    end)

    pressSlot(slotIdx)
end

