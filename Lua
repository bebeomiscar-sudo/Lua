-- =============================================
--   Main toggle
-- =============================================

GodTab:CreateSection("Riot Shield Godmode")

GodTab:CreateLabel(
    "Requires Riot Shield in your loadout. "..
    "Keeps the shield in permanent block state "..
    "and plays AbsorbedHit on incoming damage."
)

local GodToggle = GodTab:CreateToggle({
    Name         = "Enable Godmode",
    CurrentValue = false,
    Flag         = "GodmodeEnabled",
    Callback     = function(Value)
        if Value then
            local success = startGodmode()
            if not success then
                -- Force toggle back off if no shield found
                GodToggle.Value = false
            end
        else
            stopGodmode()
        end
    end,
})

-- =============================================
--   Visual effects section
-- =============================================

GodTab:CreateSection("Visual Effects")

local EffectColor = Color3.fromRGB(80, 160, 255)

GodTab:CreateColorPicker({
    Name     = "Shield Effect Color",
    Color    = Color3.fromRGB(80, 160, 255),
    Flag     = "EffectColor",
    Callback = function(Value)
        EffectColor = Value
    end,
})

GodTab:CreateButton({
    Name     = "Test Effect",
    Callback = function()
        playShieldEffect(EffectColor)
    end,
})

