                if not char then continue end
                local hum  = char:FindFirstChildOfClass("Humanoid")
                if not hum or hum.Health <= 0 then continue end
                local hrp  = char:FindFirstChild("HumanoidRootPart")
                if not hrp then continue end
                local sp, on = Camera:WorldToViewportPoint(hrp.Position)
                if on then
                    local d = (Vector2.new(sp.X, sp.Y) - cur).Magnitude
                    if d < bestD then best = char bestD = d end
                end
            end
            if best then
                Config.target.character = best
                Config.target.player    = Players:GetPlayerFromCharacter(best)
                Config.target.enabled   = true
                Library:Notification("Target", "Locked: " ..
                    (Config.target.player and Config.target.player.Name or "?"), 2)
            end
        end
    end

    -- [G] Toggle void spam
    if input.KeyCode == Enum.KeyCode.G then
        Config.void.enabled = not Config.void.enabled
        if Config.void.enabled then startVoidSpam()
        else                         stopVoidSpam()
        end
        Library:Notification("VoidSpam", Config.void.enabled and "Started" or "Stopped", 2)
    end
end)

