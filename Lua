-- =============================================
--   SLINGSHOT BYPASS (IMPROVED)
-- =============================================

local slingshotActive      = false
local slingshotHBConn      = nil
local slingshotAddedConn   = nil
local slingshotRemovedConn = nil
local trackedProjectiles   = {}
local SLING_VOID           = CFrame.new(9000, 9000, 9000)

local function improvedSlingshotBypass(obj)
    if not obj:IsA("BasePart") then return end

    -- sethiddenproperty to make parts invisible + non-collide
    pcall(function()
        sethiddenproperty(obj, "Transparency",  1)
        sethiddenproperty(obj, "CanCollide",    false)
        sethiddenproperty(obj, "CanTouch",      false)
        sethiddenproperty(obj, "CastShadow",    false)
        sethiddenproperty(obj, "Massless",      true)
    end)

    -- Also directly set visible properties
    pcall(function()
        obj.Transparency = 1
        obj.CanCollide   = false
        obj.CanTouch     = false
        obj.CastShadow   = false
    end)
end

local function startSlingshot()
    slingshotActive = true
    trackedProjectiles = {}

    slingshotAddedConn = workspace.ChildAdded:Connect(function(obj)
        if not obj:IsA("BasePart") then return end
        if obj.Name == "CoreProjectile" then
            trackedProjectiles[obj] = true
            improvedSlingshotBypass(obj)
        elseif obj.Name == "Part" then
            task.defer(function()
                if obj and obj.Parent
                    and obj.AssemblyLinearVelocity.Magnitude > 50 then
                    trackedProjectiles[obj] = true
                    improvedSlingshotBypass(obj)
                end
            end)
        end
    end)

    slingshotRemovedConn = workspace.ChildRemoved:Connect(function(obj)
        trackedProjectiles[obj] = nil
    end)

    slingshotHBConn = RunService.Heartbeat:Connect(function()
        pcall(function()
            -- Move all enemy HRPs to void
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= lp and p.Character then
                    local h = p.Character
                        :FindFirstChild("HumanoidRootPart")
                    if h then
                        -- sethiddenproperty on enemy HRP
                        pcall(function()
                            sethiddenproperty(h, "CFrame", SLING_VOID)
                        end)
                        h.CFrame = SLING_VOID
                        h.AssemblyLinearVelocity  = Vector3.zero
                        h.AssemblyAngularVelocity = Vector3.zero
                    end
                end
            end

            -- Move all CoreProjectiles
            for _, o in pairs(workspace:GetChildren()) do
                if o.Name == "CoreProjectile" and o:IsA("BasePart") then
                    pcall(function()
                        sethiddenproperty(o, "CFrame", SLING_VOID)
                    end)
                    o.CFrame = SLING_VOID
                    o.AssemblyLinearVelocity = Vector3.zero
                end
            end

            -- Move tracked projectiles
            for p in pairs(trackedProjectiles) do
                if p and p.Parent then
                    pcall(function()
                        sethiddenproperty(p, "CFrame", SLING_VOID)
                    end)
                    p.CFrame = SLING_VOID
                    p.AssemblyLinearVelocity = Vector3.zero
                else
                    trackedProjectiles[p] = nil
                end
            end
        end)
    end)
end

local function stopSlingshot()
    slingshotActive = false
    if slingshotHBConn then
        slingshotHBConn:Disconnect()
        slingshotHBConn = nil
    end
    if slingshotAddedConn then
        slingshotAddedConn:Disconnect()
        slingshotAddedConn = nil
    end
    if slingshotRemovedConn then
        slingshotRemovedConn:Disconnect()
        slingshotRemovedConn = nil
    end
    trackedProjectiles = {}
end

