UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end

    -- E: Manual target lock
    if input.KeyCode == Enum.KeyCode.E then
        if Config.target.enabled then
            Config.target.character = nil
            Config.target.player    = nil
            Config.target.enabled   = false
            Library:Notification("VoidSpam", "Target cleared", 2)
        else
            local best, bestD = nil, math.huge
            local cur = UserInputService:GetMouseLocation()
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr == LocalPlayer then continue end
                local char = plr.Character
                if not char then continue end
                local hum = char:FindFirstChildOfClass("Humanoid")
                if not hum or hum.Health <= 0 then continue end
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if not hrp then continue end
                local sp, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                if onScreen then
                    local d = (Vector2.new(sp.X, sp.Y) - cur).Magnitude
                    if d < bestD then
                        best  = char
                        bestD = d
                    end
                end
            end
            if best then
                Config.target.character = best
                Config.target.player    = Players:GetPlayerFromCharacter(best)
                Config.target.enabled   = true
                Library:Notification("VoidSpam",
                    "Locked: " .. (Config.target.player and Config.target.player.Name or "?"), 2)
            end
        end
    end

    -- G: Toggle void spam
    if input.KeyCode == Enum.KeyCode.G then
        Config.void.enabled = not Config.void.enabled
        if Config.void.enabled then
            startVoidSpam()
            Library:Notification("VoidSpam", "Started", 2)
        else
            stopVoidSpam()
            Library:Notification("VoidSpam", "Stopped", 2)
        end
    end
end)

