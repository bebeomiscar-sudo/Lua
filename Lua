--//                  PREDICTION
--// ═══════════════════════════════════════════════════════════

local function updateVelocity()
    if not Config.target.character then
        Config.prediction.velocity = Vector3.zero
        return
    end
    local hrp = Config.target.character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local now = tick()
    local dt  = now - Config.prediction.lastTime
    if dt > 0 and dt < 0.1 and Config.prediction.lastPos then
        local iv = (hrp.Position - Config.prediction.lastPos) / dt
        Config.prediction.velocity = Config.prediction.velocity:Lerp(iv, 0.6)
    end
    Config.prediction.lastPos  = hrp.Position
    Config.prediction.lastTime = now
end

local function getPing()
    local ping = 0
    pcall(function()
        ping = game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue() / 1000
    end)
    return ping
end

local function predictPos(part, origin)
    if not Config.prediction.enabled or not part then
        return part and part.Position or Vector3.zero
    end
    local dist   = (part.Position - origin).Magnitude
    local travel = dist / 3000
    local total  = (travel + getPing()) * Config.prediction.multiplier
    return part.Position + Config.prediction.velocity * total
end

local function getHitPart(char, partName)
    if not char then return nil end
    if partName == "Head" then
        return char:FindFirstChild("HitboxHead") or char:FindFirstChild("Head")
    elseif partName == "Torso" then
        return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    elseif partName == "HumanoidRootPart" then
        return char:FindFirstChild("HumanoidRootPart")
    elseif partName == "Closest" then
        local myHRP = getHRP()
        if not myHRP then return char:FindFirstChild("Head") end
        local closest, closestD = nil, math.huge
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then
                local d = (p.Position - myHRP.Position).Magnitude
                if d < closestD then closest = p closestD = d end
            end
        end
        return closest or char:FindFirstChild("Head")
    elseif partName == "Random" then
        local pool = {}
        for _, n in ipairs({"HitboxHead","Head","UpperTorso","Torso","HumanoidRootPart"}) do
            local p = char:FindFirstChild(n)
            if p then table.insert(pool, p) end
        end
        return pool[math.random(#pool)]
    else
        return char:FindFirstChild(partName) or char:FindFirstChild("Head")
    end
end

