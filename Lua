local hideAttackCfg = {
    enabled       = false,
    hideTime      = 0.25,
    attackTime    = 0.1,
    shootAttempts = 1,
}

local hideAttackThread = nil

local function getClosestEnemy()
    local best, bd = nil, math.huge
    local myChar   = lp.Character
    if not myChar then return nil end
    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return nil end

    for _, p in ipairs(Players:GetPlayers()) do
        if p == lp then continue end
        local char = p.Character
        if not char or not char:IsDescendantOf(workspace) then
            continue
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end
        local d = (myHRP.Position - hrp.Position).Magnitude
        if d < bd then bd = d; best = p end
    end
    return best
end

local function fireHideAttackShot(target)
    if not target or not target.Character then return end
    local lf   = getLocalFighter()
    if not lf then return end
    local item = lf.EquippedItem
    if not item then return end

    local ap = wbState:getHitPart(target.Character)
    if not ap then return end

    wbState:teleportDesync(target.Character)
    task.wait(0.05)

    local tPos = ap.Position
    local tCF2 = ap.CFrame
    local oPos = tPos - Vector3.new(0, 3, 0)

    if util then
        pcall(function()
            local UseItemRemote = ReplicatedStorage
                :WaitForChild("Remotes")
                :WaitForChild("Replication")
                :WaitForChild("Fighter")
                :WaitForChild("UseItem")

            local EnumLibrary = safeRequire(
                ReplicatedStorage
                    :WaitForChild("Modules")
                    :WaitForChild("EnumLibrary")
            )

            local cd = {}
            cd[utf8.char(1)] = {
                [utf8.char(0)] = util:EncodeCFrame(
                    CFrame.new(oPos, tPos)
                ),
                [utf8.char(1)] = util:EncodeCFrame(
                    CFrame.new(tPos)
                ),
                [utf8.char(2)] = ap,
                [utf8.char(3)] = util:EncodeCFrame(
                    tCF2:ToObjectSpace(CFrame.new(tPos))
                ),
            }

            UseItemRemote:FireServer(
                item:Get("ObjectID"),
                EnumLibrary:ToEnum("StartShooting"),
                cd,
                nil
            )
        end)
    end
end

local function runHideAttackLoop()
    while hideAttackCfg.enabled do
        local char = lp.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            -- HIDE
            local savedCF = hrp.CFrame
            local vPos    = getBetterVoidPos()
            hrp.CFrame    = CFrame.new(vPos)
            pcall(function()
                sethiddenproperty(hrp, "CFrame", CFrame.new(vPos))
            end)

            task.wait(hideAttackCfg.hideTime)
            if not hideAttackCfg.enabled then break end

            -- ATTACK
            local enemy = getClosestEnemy()
            if enemy and enemy.Character then
                local eHRP = enemy.Character
                    :FindFirstChild("HumanoidRootPart")
                if eHRP then
                    local attackCF = CFrame.new(
                        eHRP.Position + Vector3.new(0, 5, 0)
                    )
                    hrp.CFrame = attackCF
                    pcall(function()
                        sethiddenproperty(hrp, "CFrame", attackCF)
                    end)

                    for i = 1, hideAttackCfg.shootAttempts do
                        fireHideAttackShot(enemy)
                        if i < hideAttackCfg.shootAttempts then
                            task.wait(0.016)
                        end
                    end
                end
            end

            task.wait(hideAttackCfg.attackTime)
        else
            task.wait(0.1)
        end
    end
end

local function startHideAttack()
    hideAttackCfg.enabled = true
    if hideAttackThread then
        task.cancel(hideAttackThread)
    end
    if not wbState.hooked then
        WB.enabled = true
        wbState:Start()
    end
    hideAttackThread = task.spawn(runHideAttackLoop)
end

local function stopHideAttack()
    hideAttackCfg.enabled = false
    if hideAttackThread then
        task.cancel(hideAttackThread)
        hideAttackThread = nil
    end
end

