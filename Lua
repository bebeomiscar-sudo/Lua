        -- DROPDOWN
        function Sec:Dropdown(cfg)
            local defVal = getConfig(cfg.Flag, cfg.Default or cfg.Items[1])
            local curVal = defVal
            local open   = false
            local dropFrame = nil

            local row = Instance.new("Frame", items)
            row.Size             = UDim2.new(1,0,0,54)
            row.BackgroundColor3 = Theme.Item
            row.BorderSizePixel  = 0
            row.ClipsDescendants = false
            mkCorner(row, 5)

            mkLabel(row, cfg.Name,
                UDim2.new(1,-10,0,18), Theme.Text, Theme.FontSm
            ).Position = UDim2.new(0,10,0,4)

            local trig = Instance.new("TextButton", row)
            trig.Size             = UDim2.new(1,-20,0,26)
            trig.Position         = UDim2.new(0,10,0,24)
            trig.BackgroundColor3 = Theme.Section
            trig.Text             = "  " .. tostring(defVal)
            trig.TextColor3       = Theme.Text
            trig.TextSize         = 12
            trig.Font             = Theme.FontSm
            trig.TextXAlignment   = Enum.TextXAlignment.Left
            trig.BorderSizePixel  = 0
            trig.AutoButtonColor  = false
            mkCorner(trig, 4)
            mkStroke(trig, Theme.Border, 1)

            local arrow = mkLabel(trig, "▾",
                UDim2.new(0,18,1,0),
                Theme.Accent, Theme.Font,
                Enum.TextXAlignment.Center)
            arrow.Position = UDim2.new(1,-20,0,0)

            trig.MouseButton1Click:Connect(function()
                open = not open
                if dropFrame then
                    pcall(function() dropFrame:Destroy() end)
                    dropFrame = nil
                end
                if not open then return end

                dropFrame = Instance.new("Frame", ScreenGui)
                dropFrame.Size             = UDim2.fromOffset(
                    trig.AbsoluteSize.X,
                    math.min(#cfg.Items * 26 + 8, 200)
                )
                dropFrame.Position         = UDim2.fromOffset(
                    trig.AbsolutePosition.X,
                    trig.AbsolutePosition.Y + trig.AbsoluteSize.Y + 2
                )
                dropFrame.BackgroundColor3 = Theme.Section
                dropFrame.BorderSizePixel  = 0
                dropFrame.ZIndex           = 15
                dropFrame.ClipsDescendants = true
                mkCorner(dropFrame, 5)
                mkStroke(dropFrame, Theme.Border, 1)

                local dScroll = Instance.new("ScrollingFrame", dropFrame)
                dScroll.Size                 = UDim2.new(1,0,1,0)
                dScroll.BackgroundTransparency = 1
                dScroll.BorderSizePixel      = 0
                dScroll.ScrollBarThickness   = 2
                dScroll.ScrollBarImageColor3 = Theme.Accent
                dScroll.AutomaticCanvasSize  = Enum.AutomaticSize.Y
                dScroll.CanvasSize           = UDim2.new(0,0,0,0)

                local dLayout = Instance.new("UIListLayout", dScroll)
                dLayout.Padding   = UDim.new(0,2)
                dLayout.SortOrder = Enum.SortOrder.LayoutOrder

                local dPad = Instance.new("UIPadding", dScroll)
                dPad.PaddingTop    = UDim.new(0,3)
                dPad.PaddingBottom = UDim.new(0,3)
                dPad.PaddingLeft   = UDim.new(0,4)
                dPad.PaddingRight  = UDim.new(0,4)

                for _, item in ipairs(cfg.Items) do
                    local ib = Instance.new("TextButton", dScroll)
                    ib.Size             = UDim2.new(1,0,0,24)
                    ib.BackgroundColor3 = item == curVal
                        and Theme.AccentDark or Theme.Section
                    ib.Text             = "  " .. tostring(item)
                    ib.TextColor3       = item == curVal
                        and Theme.Text or Theme.TextDim
                    ib.TextSize         = 12
                    ib.Font             = Theme.FontSm
                    ib.TextXAlignment   = Enum.TextXAlignment.Left
                    ib.BorderSizePixel  = 0
                    ib.AutoButtonColor  = false
                    ib.ZIndex           = 16
                    mkCorner(ib, 4)

                    ib.MouseEnter:Connect(function()
                        if item ~= curVal then
                            ib.BackgroundColor3 = Theme.Panel
                        end
                    end)
                    ib.MouseLeave:Connect(function()
                        if item ~= curVal then
                            ib.BackgroundColor3 = Theme.Section
                        end
                    end)
                    ib.MouseButton1Click:Connect(function()
                        curVal     = item
                        trig.Text  = "  " .. tostring(item)
                        open = false
                        pcall(function() dropFrame:Destroy() end)
                        dropFrame = nil
                        setConfig(cfg.Flag, item)
                        if cfg.Callback then cfg.Callback(item) end
                    end)
                end

                local cc
                cc = UserInputService.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        task.defer(function()
                            if dropFrame then
                                pcall(function() dropFrame:Destroy() end)
                                dropFrame = nil
                            end
                            open = false
                            cc:Disconnect()
                        end)
                    end
                end)
            end)

            return {
                SetValue = function(v)
                    curVal    = v
                    trig.Text = "  " .. tostring(v)
                end,
                GetValue = function() return curVal end,
            }
        end

        -- INPUT
        function Sec:Input(cfg)
            local defVal = getConfig(cfg.Flag, cfg.Default or "")
            local row = Instance.new("Frame", items)
            row.Size             = UDim2.new(1,0,0,54)
            row.BackgroundColor3 = Theme.Item
            row.BorderSizePixel  = 0
            mkCorner(row, 5)

            mkLabel(row, cfg.Name,
                UDim2.new(1,-10,0,18), Theme.Text, Theme.FontSm
            ).Position = UDim2.new(0,10,0,4)

            local box = Instance.new("TextBox", row)
            box.Size              = UDim2.new(1,-20,0,26)
            box.Position          = UDim2.new(0,10,0,24)
            box.BackgroundColor3  = Theme.Section
            box.Text              = tostring(defVal)
            box.PlaceholderText   = cfg.Placeholder or ""
            box.TextColor3        = Theme.Text
            box.PlaceholderColor3 = Theme.TextDim
            box.TextSize          = 12
            box.Font              = Theme.FontSm
            box.BorderSizePixel   = 0
            box.ClearTextOnFocus  = false
            mkCorner(box, 4)
            mkStroke(box, Theme.Border, 1)

            box.FocusLost:Connect(function()
                setConfig(cfg.Flag, box.Text)
                if cfg.Callback then cfg.Callback(box.Text) end
            end)
            return box
        end

        -- LABEL
        function Sec:Label(text)
            local l = mkLabel(items, text,
                UDim2.new(1,-10,0,16), Theme.TextDim, Theme.FontSm)
            l.Position = UDim2.new(0,5,0,0)
            l.TextWrapped = true
        end

        return Sec
    end

    return {
        Section = mkSection,
        Page    = page,
    }
end

